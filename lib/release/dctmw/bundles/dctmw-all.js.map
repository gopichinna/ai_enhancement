csui.define('txt!dctmw/controls/form/containers/alpaca/impl/fieldset/fieldset.txt',[],function () { return '<div class="binf-col-md-12 dctm-set-container dctm-container dctm-fieldset-layout dctm-nested-fieldset-layout">\n     <h5 class=\'dctm-nested-fieldset-layout-heading\'>{{options.containerLabel}}</h5>\n\n{{#each items}}\n      <div class=\'binf-col-md-12\'>\n        <div class=\' {{#xif "this.options.stretch === true"}}  binf-col-md-12{{else}}binf-col-md-6{{/xif}} dctmw-control cs-form-doublecolumn\'>\n          {{#item}}{{/item}}\n        </div>\n      </div>\n{{/each}}\n</div>\n\n';});
