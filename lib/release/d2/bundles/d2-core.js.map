csui.define('txt!d2/controls/form/impl/d2fieldsetcontainer/d2fieldsetcontainer.txt',[],function () { return '{{#if options.isSpyScrollContainer}}\n  <div class="binf-col-md-12 d2-set-container d2-container d2-fieldset-layout">\n{{else}}\n  <div class="binf-col-md-12 d2-set-container d2-container d2-fieldset-layout d2-nested-fieldset-layout">\n     <h5 class=\'d2-nested-fieldset-layout-heading\'>{{options.containerLabel}}</h5>\n{{/if}}\n{{#each items}}\n   {{#xif "this.options._d2Containertype != null"}}\n    {{#xif "this.options._d2Containertype === \'d2grid\'"}}\n      <div class=\'binf-col-md-12 csui-form-set-array-wrapper cs-form-set\'>\n    {{else}}\n      <div class=\'binf-col-md-12\'>\n    {{/xif}}\n    {{#item}}{{/item}}\n    </div>\n  {{else}}\n      <div class=\'binf-col-md-12\'>\n        <div class=\' {{#xif "this.options.stretch === true"}}  binf-col-md-12{{else}}binf-col-md-6{{/xif}} d2-control cs-form-doublecolumn\'>\n          {{#item}}{{/item}}\n        </div>\n      </div>\n  {{/xif}}\n{{/each}}\n</div>\n\n';});
