csui.define('txt!d2/controls/form/impl/d2columnlayout/d2columnlayout.txt',[],function () { return '<div class="binf-col-md-12 cs-form-singlecolumn d2-set-container d2-container d2-column-layout">\n  {{#each items}}\n    {{#xif "this.options._d2Containertype != null"}}\n      {{#xif "this.options._d2Containertype === \'d2grid\'"}}\n      <div class=\'binf-col-md-12 csui-form-set-array-wrapper cs-form-set d2-control\'>\n      {{else}}\n      <div class=\'binf-col-md-12\'>\n      {{/xif}}\n      {{#item}}{{/item}}\n    </div>\n    {{else}}\n      {{#if ../../options.singleColumn}}\n        <div class=\'binf-col-md-12\'>\n         {{#xif "this.options.stretch"}}\n            <div class=\'binf-col-md-12 d2-control cs-form-doublecolumn\'>\n          {{else}}\n            <div class=\'binf-col-md-6 d2-control cs-form-doublecolumn\'>\n          {{/xif}}\n            {{#item}}{{/item}}\n          </div>\n        </div>\n      {{else}}\n       {{#xif "this.options.stretch"}}\n        <div class=\'binf-col-md-12 d2-control cs-form-doublecolumn\'>\n        {{else}}\n        <div class=\'binf-col-md-6 d2-control cs-form-doublecolumn\'>\n        {{/xif}}\n          {{#item}}{{/item}}\n        </div>\n      {{/if}}\n    {{/xif}}\n  {{/each}}\n</div>';});
