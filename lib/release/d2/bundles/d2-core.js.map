csui.define('txt!d2/controls/form/impl/d2tabgroup/tabgroupcontainer.txt',[],function () { return '<div id="{{options.uniqueId}}" class="d2tabgroupcontainer d2-container binf-col-md-12 {{#xif "this.options.layoutMode == \'singleCol\'" }}single-mode{{/xif}}">\n            <div class="d2tabgroupheader">\n                <ul role="tablist" class="d2tabgroup binf-nav binf-nav-pills ">\n                    {{#each options.fields}}\n                        <li id="d2tabgroupli_{{this.uniqueId}}" role="tab" aria-label="{{this.containerLabel}}"" title="{{this.containerLabel}}"" aria-selected="true">\n                            <a href="#{{this.uniqueId}}" class="cs-tablink d2tabgroupalink" data-binf-toggle="tab" ">\n                                <span class="cs-icon-required category_required" aria-label="{{required_tooltip}}"></span>\n                                <span class="cs-tablink-text">{{this.containerLabel}}</span>\n                            </a>\n                        </li>\n                    {{/each}}\n                </ul>\n            </div>\n        {{#each items}}\n            {{#item}}{{/item}}\n        {{/each}}\n</div>\n';});
