csui.define('txt!d2/widgets/task.aviator/aie/utils/clipboard/impl/clipboard.css',[],function () { return '/* synchronise with src/controls/chat/impl/messages/post.css */\n\n:root {\n  font-family: \'OpenText Sans\', Arial, Helvetica, sans-serif;\n  color: var(--jato-typography-text-color-primary, #333333);\n  font-size: 14px;\n  line-height: 20px;\n  text-overflow: ellipsis;\n  overflow-wrap: break-word;\n  hyphens: auto;\n  overflow-x: hidden;\n}\n\n/* paragraphs */\n\np {\n  margin-block-end: 12px;\n}\n\np:last-child {\n  margin-block-end: 0;\n}\n\n/* lists */\n\nol,\nul {\n  list-style-type: initial;\n  margin-inline-start: 16px;\n  margin-block-end: 12px;\n}\n\n/* remove extra space after paragraphs and lists */\n\np:last-child,\nol:last-child,\nul:last-child,\ntable:last-child {\n  margin-block-end: 0;\n}\n\n/* bold text */\n\nb,\nstrong {\n  font-weight: 700;\n}\n\n/* hyperlinks */\n\na {\n  font-weight: 700;\n  color: var(--jato-tabs-navigation-indicator-selected,#1a6aff);\n  text-decoration: none;\n}\n\na:visited {\n  color: #d0008d;\n}\n\na:hover {\n  color: var(--jato-tabs-navigation-indicator-hover,#2f4ed1);\n  text-decoration: underline;\n  text-underline-offset: 20%;\n}\n\na:active {\n  color: var(--jato-tabs-navigation-indicator-active,#111b58);\n}\n\na:focus {\n  color: var(--jato-color-electric-1770, #1a6aff);\n  text-decoration: none;\n}\n\na:focus-visible {\n  box-shadow: 0 0 0 1px #2e3d98;\n}\n\n/* tables */\n\n.aie-dyna-table-wrapper {\n  overflow-x: auto;\n}\n\ntable {\n  background-color: #f4f4f4;\n  border-radius: 6px;\n  color: var(--jato-typography-text-color-primary, #333333);\n  font-size: 13px;\n  line-height: 18px;\n  text-align: start;\n}\n\ntable {\n  margin-block-end: 12px;\n}\n\nthead {\n  padding: 2px 4px 2px 4px;\n  border-bottom: 1px solid #999999;\n  font-weight: 700;\n}\n\ntbody tr {\n  padding: 4px;\n  border-bottom: 2px solid #ffffff;\n}\n\ntbody tr:last-child {\n  border-bottom: none;\n}\n\nth,\ntd {\n  padding: 8px;\n}\n\ntd:first-child:not(:last-child) {\n  font-weight: 700;\n}\n';});
