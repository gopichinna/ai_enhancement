<div class="smart-group-card-header smart-card-visible" tabindex="0" role="button" aria-label="{{name}}" aria-expanded="true" aria-haspopup="menu">
    <div class="smart-group-card-header-toggle-btn">
        <otc-icon icon="smart_action_16:action_caret_down16" iconAppearance="{{iconAppearance}}"
            class="smart-left-panel-group-icon smart-left-panel-group-icon-up" title="{{collapseTooltip}}" arialabel=""></otc-icon>
        <otc-icon icon="smart_action_16:action_caret_right16" iconAppearance="{{iconAppearance}}"
            class="smart-left-panel-group-icon smart-left-panel-group-icon-down binf-hidden {{rtlClass}}" title="{{expandTooltip}}"
            arialabel=""></otc-icon>
    </div>
    <div class="smart-group-card-header-icon"></div>
    <div class="smart-group-card-header-title">{{name}}</div>
</div>
<div class="smart-group-card-list binf-collapse binf-in"></div>
