<div class="csui-global-message ot-section"></div>
<div class="smart-app-header-otc-skiplinks binf-hidden"></div>
<div class="smart-app-header-otc-burger-menu-view binf-hidden"></div>
<otc-header-bar {{{transparentAttribute}}} class="smart-application-header">
  {{#if enableHamburger}}
    {{#if isJato}}
      <otc-button class="smart-app-header-burger-menu-btn" arialabel="{{burgerAriaLabel}}" title="{{burgerTitle}}" slot="hamburger">
        <otc-icon size="24" svg="{{jatoBurgerExpandIcon}}"></otc-icon>
      </otc-button>
    {{else}}
      <otc-button class="smart-app-header-burger-menu-btn" arialabel="{{burgerAriaLabel}}" headeritem="" title="{{burgerTitle}}"
        icon="smart_action_header:header_hamburger42" slot="hamburger" iconappearance="{{iconAppearance}}">
      </otc-button>
    {{/if}}
  {{/if}}
  <otc-overflow-container slot="rightToolbar" maxitems="0" wrapwideitems="" overflowmenuarialabel="{{overflowAria}}"
    overflowmenutitle="{{overflowAria}}" overflowmenuiconappearance="{{iconAppearance}}"></otc-overflow-container>
</otc-header-bar>
