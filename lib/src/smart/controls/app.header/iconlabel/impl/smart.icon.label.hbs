{{#if jatoIcon}}
    <otc-icon svg="{{jatoIcon}}" size="16" type="" ispresentation="" class="smart-icon-label-icon"></otc-icon>
{{else}}
  {{#if iconText}}
    <div class="smart-cf-icon-svg-text">{{{iconText}}}</div>
  {{else}}
    <otc-icon icon="{{icon}}" ispresentation="" disableEffects="" class="smart-icon-label-icon"></otc-icon>
  {{/if}}
{{/if}}
{{#if title}}
    <div class="smart-icon-label-label">
        {{title}}
    </div>
{{/if}}
