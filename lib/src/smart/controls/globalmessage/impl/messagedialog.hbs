<div class="csui-header csui-height-target">
  <div class="csui-header-top">
    <div class="csui-state">
      {{#if isJATO}}
      <span class="smart-state-icon"></span>
      {{else}}
      <otc-icon class="smart-state-icon" isPresentation></otc-icon>
      {{/if}}
    </div>
    <div class="csui-text" id="{{headerId}}" title="{{header_text}}">{{header_text}}</div>
    <div class="csui-action">
      {{#if details_text}}
        <div class="csui-expand">
        {{#if isJATO}}
          <otc-button class="smart-action-moredetails" size="small" arialabel="{{expandAria}}" title="{{expand}}">
            <otc-icon svg="{{expandSVGContent}}"></otc-icon>
          </otc-button>
          <otc-button class="smart-action-fewerdetails binf-hidden" size="small" arialabel="{{collapseAria}}" title="{{collapse}}">
            <otc-icon svg="{{collapseSVGContent}}"></otc-icon>
          </otc-button>
        {{else}}
          <otc-button class="smart-action-moredetails" icon="smart_action:action_caret_down32" arialabel="{{expandAria}}" title="{{expand}}"></otc-button>
          <otc-button class="smart-action-fewerdetails binf-hidden" icon="smart_action:action_caret_up32" arialabel="{{collapseAria}}" title="{{collapse}}"></otc-button>
        {{/if}}
        </div>
      {{/if}}
        {{#if isJATO}}
        <otc-button class="smart-action-close" size="small" arialabel="{{closeDialogAria}}" title="{{closeDialog}}">
          <otc-icon svg="{{closeSVGContent}}"></otc-icon>
        </otc-button>
        {{else}}
        <otc-button class="smart-action-close" icon="smart_action:action_close_min32" arialabel="{{closeDialogAria}}" title="{{closeDialog}}"></otc-button>
        {{/if}}
    </div>
  </div>
  {{#if targetLocationUrl}}
  <div class="csui-gotolocation-label">
    <otc-link class="csui-gotolocation-url" href="{{targetLocationUrl}}">{{gotoLocation}}</otc-link>
  </div>
  {{/if}}
   {{#if openInNewTabLink}}
  <div class="csui-gotolocation-label">
    <otc-link class="csui-gotonewtab-link" href="{{openInNewTabLink}}" target="_blank" arialabel="{{OpenInNewTabLinkAria}}">{{gotoLocation}}</otc-link>
  </div>
  {{/if}}
</div>

{{#if message_with_link}}
<div class="csui-message-link-div">
  <otc-link href="{{link_url}}" class="csui-message-link">{{link_label}}</otc-link>
</div>
{{/if}}

{{#if details_text}}
<div class="csui-details-wrapper">
  <div id="csui-message-details" class="csui-details csui-minheight">
    <div class="csui-text binf-hidden" id="{{detailsId}}">{{details_text}}</div>
  </div>
</div>
{{/if}}
