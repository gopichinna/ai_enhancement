{{#if extraTabs}}
  <div class="binf-col-lg-12 binf-col-md-12 binf-col-sm-12 binf-col-xs-12 esoc-profile-tabs
  esoc-nopadding-right tab-links smart-tab-links">

    <div class="tab-links-header smart-tab-links-bar-toolbar-wrapper">
      <div class="left-toolbar smart-left-toolbar">
        <div class="goto_previous_div">
          {{#if isJATO}}
          <otc-button class="cs-icon smart-goto-previous-page" title="{{gotoPreviousTooltip}}" arialabel="{{gotoPreviousTooltip}}" tabindex="-1">
            <otc-icon svg="{{jatoLeftArrowIconName}}"></otc-icon>
          </otc-button>
          {{else}}
          <otc-icon disableEffects="true" icon="{{leftArrowIconName}}" class="cs-icon smart-goto-previous-page" 
              title="{{gotoPreviousTooltip}}" isPresentation arialabel="{{gotoPreviousTooltip}}"></otc-icon>
          {{/if}}
        </div>
      </div>

       <div class="tab-links-bar  smart-tab-links-bar">
        <ul class='binf-nav binf-nav-tabs binf-nav-pills esoc-user-profile-tabcontainer' role="tablist">

        {{#each extraTabs}}
          {{#this}}
            {{#if show}}
              <li role="tab" class="esoc-user-profile-tab smart-tab-panel-item"
                  id="esoc-user-profile-{{tabName}}-tab">
                <a href="#{{tabName}}" data-binf-toggle="tab"
                        class="esoc-user-profile-{{tabName}}-tab-label cs-tablink"  tabindex="-1" title= "{{tabDisplayName}}">
              <span class="esoc-user-{{tabName}}-tab-label esoc-user-profile-tab-label"
                    title="{{tabDisplayName}}">{{tabDisplayName}}</span>
                </a>
                 {{#if tabCount}}
                    <span class="esoc-user-{{tabName}}-count
              esoc-user-profile-tab-count esoc-user-profile-tab-label"
                          title="{{tabCount.count}}">{{tabCount.count}}</span>
                  {{/if}}
              </li>
            {{/if}}
          {{/this}}
        {{/each}}
      </ul>
       </div>
      <div class="right-toolbar smart-right-toolbar">
        <div class="goto_next_div">
          {{#if isJATO}}
          <otc-button class="cs-icon smart-goto-next-page" title="{{gotoNextTooltip}}" arialabel="{{gotoNextTooltip}}" tabindex="-1">
            <otc-icon svg="{{jatoRightArrowIconName}}"></otc-icon>
          </otc-button>
          {{else}}
          <otc-icon disableEffects="true" icon="{{rightArrowIconName}}" class="cs-icon smart-goto-next-page" 
              title="{{gotoNextTooltip}}" isPresentation arialabel="{{gotoNextTooltip}}"></otc-icon>
          {{/if}}
        </div>
      </div>
      </div>    
  </div>
   <div id="esoc-simple-user-widget-form-body-{{uniqueId}}"
      class="esoc-simple-user-widget-form-body smart-tab-contents-wrapper csui-normal-scrolling" role="tabpanel"></div>
{{else}}
  <div id="esoc-simple-user-widget-form-body-{{uniqueId}}" class="esoc-simple-user-widget-form-body smart-tab-contents-wrapper csui-normal-scrolling" role="tabpanel"></div>
{{/if}}

