<div class="esoc-simple-user-widget">
  <div class="esoc-simple-user-widget-header">
    {{#if backButton}}
    <div class="arrow_back cs-go-back user-widget-view-back smart-handle-rtl" role="button" title="{{goBackTo}}"
      aria-label="{{goBackTo}}" tabindex="0" data-cstabindex="0"></div>
    {{/if}}
    <div class="esoc-userprofile-pic-actions">
      {{#if chatSettings.chatEnabled}}
      {{!-- {{#if chatSettings.presenceEnabled}} --}}
      <div id="esoc-user-profile-presence-indicator" class="esoc-user-profile-presence-indicator binf-hidden">
        <div id="esoc-chat-presence-indicator-{{userid}}" class="esoc-chat-presence-indicator" title="" aria-label=""
          tabindex="0" role="status"></div>
      </div>
      {{!-- {{/if}} --}}
      {{/if}}

      <otc-avatar class="{{^if otherUser}} esoc-full-profile-avatar-cursor {{/if}}
       esoc-userprofile-default-avatar esoc-full-profile-avatar-update
    esoc-user-default-avatar-{{userid}} esoc-userprofile-img-{{userid}}" id="esoc-simple-user-default-avatar-{{uniqueId}}" title="{{messages
      .displayname}}" arialabel="{{simpleUserProfileLabel}}" initials="{{initials}}"></otc-avatar>

      {{#if isEditable}}
      {{#if isJATO}}
      <otc-button size="large" class="edit-user-image-placeholder edit-user smart-button-clip" id="edit-esoc-simple-user-default-avatar-{{uniqueId}}" title="{{edituserProfileTitle}}" arialabel="{{edituserProfileTitle}}" tabindex="{{#if isEditable}} 0 {{/if}}">
        <otc-icon svg="{{editSVGContent}}"></otc-icon>
      </otc-button>
      {{else}}
      <button class="edit-user-image-placeholder edit-user" id="edit-esoc-simple-user-default-avatar-{{uniqueId}}" title="{{edituserProfileTitle}}" aria-label="{{edituserProfileTitle}}" tabindex="{{#if isEditable}} 0 {{/if}}"></button>
      {{/if}}
      <input type="file" id="esoc-profilepic-desktop-attachment" class="esoc-profilepic-desktop-attachment"
        name="updateProfilePic" accept="image/*" aria-label="{{simpleUserProfileLabel}}" />

      <div class="edit-user-image-options">
        <otc-menu class="esoc-simple-user-profile-pic-update" buttonid="edit-esoc-simple-user-default-avatar-{{uniqueId}}">
            <otc-menuitem class="esoc-simple-user-profile-pic-edit esoc-profile-pic-edit" arialabel="{{uploadProfilePicture}}" tabindex="-1">{{uploadProfilePicture}}</otc-menuitem>
            <otc-menuitem class="esoc-simple-user-profile-pic-delete esoc-profile-pic-edit" arialabel="{{deleteProfilePicture}}" tabindex="-1">{{deleteProfilePicture}}</otc-menuitem>
        </otc-menu>
      </div>

      <div class="esoc-simple-profile-img-load-container esoc-social-progress-style">
        <div class="esoc-simple-profile-img-loader" id="user_icon">
          <div id="loading_dots">
            <div id="dot_1" class="loading_dots"></div>
            <div id="dot_2" class="loading_dots"></div>
            <div id="dot_3" class="loading_dots"></div>
          </div>
        </div>
      </div>
      {{/if}}
    </div>

    <div class="esoc-user-name csui-normal-scrolling">
      <div class="smart-user-name-wrapper">
        <span class="smart-user-name">{{display_name}}</span>
        {{#if showChatIcon}}
          {{#if isJATO}}
            <otc-button class="esoc-user-profile-chat-comment" size="small" title="{{chatLabel}}" arialabel="{{chatLabel}}" tabindex="0">
              <otc-icon svg="{{chatSVGContent}}"></otc-icon>
            </otc-button>
          {{else}}
            <span class="esoc-user-profile-chat-comment smart-v2-icon-parent" title="Chat" tabindex="0" role="button">
              {{{icon-v2 iconName='csui_action_chat24' states='true'}}}
            </span>
          {{/if}}
        {{/if}}
      </div>
      {{#if title}}
      <div class="esoc-user-title">{{title}}</div>
      {{/if}}
    </div>
    {{#if isJATO}}
      <otc-button class="user-widget-view-close" size="small" title="{{closeButtonTooltip}}" arialabel="{{closeLabel}}">
        <otc-icon type="secondary" svg="{{closeSVGContent}}"></otc-icon>
      </otc-button>
    {{else}}
      <otc-button icon="smart_action:action_close_max32" class="user-widget-view-close" title="{{closeButtonTooltip}}"
      arialabel="{{closeLabel}}" tabindex="0"></otc-button>
    {{/if}}
  </div>
  <div class="esoc-simple-user-widget-body csui-normal-scrolling">
    <div class="esoc-simple-user-widget-tabs"></div>
  </div>
</div>
<div class="esoc-simple-user-widget-backdrop"></div>
