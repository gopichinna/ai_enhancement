<span class="smart-target-browse-checkbox smart-dummy-checkbox"></span>
<div class="smart-inlineform-field-container smart-inlineform-grid-container">
    <div class="smart-grid-inlineform smart-inlineform-type-name">
        <otc-input arialabel="{{addNamePlaceholder}}" class="smart-grid-input smart-edit-input-name" label="Name"
            placeholder="{{addNamePlaceholder}}" type="text" value="">
        </otc-input>
        {{#if isMlDataEnabled}}
        <span class="smart-multilingual-icon-label smart-multilingual-icon-grid">
            <otc-button icon="smart_action:action_localize32" class="icon smart-multilingual-icon"
                arialabel="{{multilingualTooltip}}" title="{{multilingualTooltip}}" tabindex="0"></otc-button>
        </span>
        {{/if}}
    </div>
    <div class="smart-inlineform-group smart-inlineform-group-error binf-hidden">
        <div class="binf-text-danger smart-error-alert" role="alert" title="{{errorMessage}}">
            <span class="smart-text-danger smart-error-text">{{errorMessage}}</span>
        </div>
    </div>
</div>
<div class="smart-inlineform-footer">
    <div class="smart-inline-action-button-wrapper">
        <otc-button disabled class="smart-edit-save" icon="smart_action:action_confirm32"
            arialabel="{{saveEditArialabel}}" title="{{saveEditTooltip}}" tabindex="0"></otc-button>
        <otc-button icon="smart_action:action_cancel32" class="smart-edit-cancel" arialabel="{{editCancelArialabel}}"
            title="{{editCancelTooltip}}" tabindex="0"></otc-button>
    </div>
</div>
