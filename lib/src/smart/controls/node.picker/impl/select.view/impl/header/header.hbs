<div class="csui-targetbrowse-history">
    {{#if isJATO}}
      <otc-button class="csui-targetbrowse-arrow-back cs-go-back
      icon smart-v2-icon-parent"
        title="{{backButtonTooltip}}" arialabel="{{backButtonAria}}" data-cstabindex="-1" size="small">
        <otc-icon svg="{{jatoActionArrowLeft}}" isPresentation></otc-icon>
      </otc-button>
    {{else}}
      <otc-button icon="smart_action:action_back32" class="csui-targetbrowse-arrow-back cs-go-back
      icon smart-v2-icon-parent"
        title="{{backButtonTooltip}}" arialabel="{{backButtonAria}}" data-cstabindex="-1"></otc-button>
    {{/if}}
</div>
{{#if searchView}}
<div class="csui-search-item-left-panel">
  <div class="csui-search-item-type smart-v2-icon-parent">
    {{#if isJATO}}
      <otc-icon svg="{{jatoActionDocument}}" class="smart-jato-item-type" size="16" isPresentation></otc-icon>
    {{else}}
      <otc-icon icon="smart_action:action_mime32" ispresentation disableeffects></otc-icon>
    {{/if}}
  </div>
  <div class="csui-search-item">
    <div class="csui-search-item-name">
      {{name}}
    </div>
  </div>
</div>
  <div class="csui-search-item-right-panel">
    <div class="csui-search-item-location">
      <div class="csui-search-toolbar-container">
        {{location}}
      </div>
    </div>
  </div>
{{else}}
  <div class="csui-folder-name">
    <h3 class="folder-name smart-header-container" title="{{title}}">{{title}}</h3>
    {{#if enableSearch}}
      <div class="cs-modal-filter">
          <otc-typeahead-search class="icon-sv-search smart-typeahead-search csui-acc-focusable" arialabel="{{searchInButtonAria}}"
          title="{{searchInButtonAria}}" tabindex="0" data-cstabindex="-1" >
            <otc-input class="cs-filter-input smart-typeahead-search-input" title="{{inputTitle}}" arialabel="{{search_aria}}" type="search" placeholder="{{search_placeholder}}" actionicon="" 
                closeicontitle="{{collapseSearch}}" closeiconarialabel="{{collapseSearch}}" value="" slidein="" autocomplete="off"
                clearicontitle="{{clearSearchButtonAria}}" cleariconarialabel="{{clearSearchButtonAria}}" tabindex="0" data-cstabindex="-1">
            </otc-input>
          </otc-typeahead-search>
      </div>
    {{/if}}
  </div>


  <div class="smart-header-tools smart-header-container"></div>
{{/if}}

