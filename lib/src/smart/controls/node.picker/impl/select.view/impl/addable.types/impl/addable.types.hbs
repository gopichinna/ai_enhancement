{{#if isJATO}}
    <otc-button title="{{addItemtooltip}}" id="{{id}}" class="smart-toggle smart-add-toolbar csui-acc-focusable" 
    arialabel="{{addItemtooltip}}" data-cstabindex="-1" tabindex="-1" size="small">
        <otc-icon svg="{{jatoActionAddIcon}}" isPresentation></otc-icon>
    </otc-button>
{{else}}
    <otc-button icon="smart_action:action_add32" title="{{addItemtooltip}}" id="{{id}}" class="smart-toggle smart-add-toolbar csui-acc-focusable" arialabel="{{addItemtooltip}}" data-cstabindex="-1" tabindex="-1"></otc-button>
{{/if}}
<otc-menu alignment="right" id="addable-types-menu-{{id}}" buttonId="{{id}}" class="smart-addable-types-menu binf-hidden" buttonAlignment="right" scrollable>
</otc-menu>
