<otc-button id="{{id}}" {{#if isJATO}}type="subtle"{{else}}type="inline"{{/if}} size="small" class="smart-inline-text-small-btn  csui-acc-focusable toggler"
  ariahaspopup="true"  arialabel="{{labelSelectLocation}}">
  {{location}}
  {{#if isJATO}}
    <otc-icon svg="{{jatoDownArrowIconSvg}}" isPresentation class="smart-icon smart-caret-down"></otc-icon>
  {{else}}
    <otc-icon icon="smart_action_16:action_caret_down16" isPresentation class="smart-icon smart-caret-down"></otc-icon>
  {{/if}}
</otc-button>
<otc-menu id="menu-{{id}}" buttonId="{{id}}" scrollable arialabel="{{location}}" role="none"></otc-menu>

