<otc-button id="{{id}}" type="inline" size="small" class="smart-inline-text-small-btn csui-acc-focusable toggler" ariahaspopup="true"
  arialabel="{{applyPropertiesAria}}">
   <span class="cs-label">{{name}}</span>
    {{#if isJATO}}
    <otc-icon svg="{{jatoDownArrowIconSvg}}" class="smart-icon smart-caret-down" isPresentation></otc-icon>
  {{else}}
    <otc-icon icon="smart_action_16:action_caret_down16" class="smart-icon smart-caret-down" isPresentation></otc-icon>
  {{/if}}
</otc-button>
<otc-menu id="menu-{{id}}" buttonId="{{id}}" role="none" iswide forceopenup scrollable>
  {{#each applyPropertiesOptions}}
  <otc-menucheckbox data-optionid="{{this.id}}" altStyle="true" role="menuitem">{{this.name}}</otc-menucheckbox>
  {{/each}}
  {{#if showOpenSelectedProperties}}
  {{#if showDivider}}
  <otc-menudivider></otc-menudivider>
  {{/if}}
  <otc-menucheckbox class="open-selected-properties" role="menuitem">{{openSelectedProperties}}</otc-menucheckbox>
  {{/if}}
</otc-menu>
