<button id="{{id}}" class="binf-btn smart-inline-text-small-btn csui-acc-focusable toggler" aria-haspopup="true"
  aria-expanded="false" aria-label="{{applyPropertiesAria}}">
  <span class="cs-label">{{name}}</span>
  <span class="cs-icon smart-icon-caret-down" title="{{applyPropertiesAria}}">
    {{{icon-v2 iconName="csui_smart_tree_caret_down16" size="contain"}}}
  </span>
</button>
<otc-menu id="menu-{{id}}" buttonId="{{id}}" aria-labelledby="{{id}}" role="none" iswide forceopenup scrollable>
  {{#each applyPropertiesOptions}}
  <otc-menucheckbox data-optionid="{{this.id}}" altStyle="true" role="menuitem">{{this.name}}</otc-menucheckbox>
  {{/each}}
  {{#if showOpenSelectedProperties}}
  {{#if showDivider}}
  <otc-menudivider></otc-menudivider>
  {{/if}}
  <otc-menucheckbox class="open-selected-properties" role="menuitem">{{openSelectedProperties}}</otc-menucheckbox>
  {{/if}}
</otc-menu>
