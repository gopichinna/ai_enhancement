<otc-menugroup class="smart-menu-group">
  <otc-menuradio class="csui-selected-checkbox csui-searchbox-option csui-search-from-here" id="{{this.nodeIdSO}}" data-cstabindex="-1"
    arialabel="{{this.selectFromHereAria}}" title="{{this.select}}{{this.fromHere}}" value="{{this.nodeId}}" altStyle>
    <span class="cs-ellipsis">{{this.fromHere}}</span>
  </otc-menuradio>
  <otc-menuradio class="csui-selected-checkbox csui-searchbox-option csui-search-all-loc" data-cstabindex="-1"
    arialabel="{{this.selectAllLocAria}}" title="{{this.select}}{{this.allLoc}}" altStyle>
    <span class="cs-ellipsis">{{this.allLoc}}</span>
  </otc-menuradio>
</otc-menugroup>
