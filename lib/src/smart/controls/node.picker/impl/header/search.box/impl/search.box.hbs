<div class="search-bar">
  <div class="search-bar-content">
    <span class="smart-search-icon show-icon smart-v2-icon-parent">
      {{{icon-v2 iconName="csui_smart_utility_search16" size="contain"}}}
    </span>
    <div class="csui-search-input-container">
      <input type="search" class="csui-input csui-acc-focusable" placeholder="{{messages.placeholder}}"
        title="{{messages.searchBoxTitle}}" tabindex="0" data-cstabindex="-1" aria-label="{{messages.searchBoxTitle}}">
      <otc-menu class="smart-search-options-dropdown" scrollable isseach iswide role="none"></otc-menu>
    </div>
    <otc-button icon="smart_action_16:action_close16" class="csui-clearer csui-acc-focusable
    smart-v2-icon-parent" title="{{messages.clearerTitle}}"
      arialabel="{{messages.clearerTitle}}" tabindex="0" data-cstabindex="-1">
    </otc-button>
  </div>
</div>
<otc-button icon="smart_action:action_search32" class="smart-global-search-toggler binf-hidden" title="{{messages.searchIconTitle}}" arialabel="{{messages.searchIconAria}}"
  aria-expanded="false" aria-haspopup="true" tabindex="0" data-cstabindex="-1"></otc-button>

