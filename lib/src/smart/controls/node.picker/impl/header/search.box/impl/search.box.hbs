<otc-search-persistent class="smart-otc-search-input" labeltext="{{messages.labelText}}" title="{{messages.searchBoxTitle}}"
  arialabelsearchbox="{{messages.searchBoxTitle}}" searchplaceholder="{{messages.placeholder}}"
  tooltipclearkeywords="{{messages.clearerTitle}}" tooltipstartsearch="{{messages.startSearch}}"
  ariaLabelInputDescription="{{messages.ariaLabelInputDescription}}"
  ariaLabelInputField="{{messages.ariaLabelInputField}}" ariaLabelSearchBox="{{messages.ariaLabelSearchBox}}"
  arialabelclearkeywords="{{messages.arialabelclearkeywords}}"
  arialabelsearchbuttonopen="{{messages.arialabelsearchbuttonopen}}"
  arialabelstartsearch="{{messages.arialabelstartsearch}}"
  tooltipsearchbuttonopen="{{messages.arialabelsearchbuttonopen}}" size="md">
  <otc-menu class="smart-search-options-dropdown" scrollable issearch iswide role="none">
    <otc-menuplaceholder errortext="{{messages.errorText}}" loadingtext="{{messages.loadingText}}" role="none"></otc-menuplaceholder>
  </otc-menu>
</otc-search-persistent>

{{#if isJATO}}
  <otc-button class="smart-global-search-toggler binf-hidden"
    title="{{messages.searchIconTitle}}" arialabel="{{messages.searchIconAria}}" ariaexpanded="false" ariahaspopup="true"
    tabindex="0" data-cstabindex="-1">
    <otc-icon svg="{{jatoActionSearchIcon}}" class="smart-search-jato-icon" isPresentation></otc-icon>
  </otc-button>
{{else}}
  <otc-button icon="smart_action:action_search32" class="smart-global-search-toggler binf-hidden"
    title="{{messages.searchIconTitle}}" arialabel="{{messages.searchIconAria}}" ariaexpanded="false" ariahaspopup="true"
    tabindex="0" data-cstabindex="-1"></otc-button>
{{/if}}
