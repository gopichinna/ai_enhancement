<span class="smart-list csui-item-standard csui-list-group-item {{#if hasTableToolbarView}}smart-custom-item-wrapper{{/if}}{{#if inlineForm}} csui-inlineform-row {{/if}}">
  {{#if inlineForm}}
  {{#if hasTableToolbarView}}
  <span class="smart-type-icon" aria-hidden="true" title="{{iconTitle}}"></span>
  {{/if}}
  <div class="csui-inlineform-container"></div>
  {{else}}
  <span class="smart-target-browse-checkbox csui-selectable {{selected}}">
    {{#if isSingleSelect}}
      {{#if isJATO}}
        <otc-icon svg="{{jatoActionCheckmarkSelect}}" class="smart-checkbox-jato-icon" isPresentation disableeffects></otc-icon>
      {{else}}
        <otc-icon icon="smart_action:action_confirm32" ispresentation disableeffects></otc-icon>
      {{/if}}
    {{else}}
    <otc-checkbox class="smart-np-list-checkbox" {{#if disableCheckbox}}disabled{{/if}}
      interactiveonly="true" tabindex="-1"></otc-checkbox>
    {{/if}}
  </span>
  <span class="csui-browsable">
    <span class="csui-type-icon" aria-hidden="true" title="{{iconTitle}}">
       <span class="smart-type-icon" aria-hidden="true"></span>
    </span>
    <span class="smart-list-title ">
      <span class="smart-flex-guard">
        <span title="{{name}}" class="csui-list-item-title {{#if notBrowsable}}smart-disabled-list-item{{/if}}"  tabindex="-1">
          {{name}}
        </span>
        <span class="binf-hidden smart-indicator-wrapper"></span>
      </span>
      {{#if secText}}
      <span title="{{secText}}" id="{{secTextId}}" class="smart-list-item-sec-text" tabindex="-1">
        {{secText}}
      </span>
      {{/if}}
    </span>
  </span>
  {{#if isSearchView}}
  <span class="smart-location-group">
  <span class="csui-type-location-icon" aria-hidden="true">
     <span class="smart-type-location-icon" aria-hidden="true"></span>
  </span>
  <span title="{{locationName}}"
    class="smart-location-title" tabindex="-1">{{locationName}}</span>
    </span>
  {{/if}}
   {{#unless showInlineActionBar}}
  <span class="csui-icon csui-end-icon smart-v2-icon-parent">
    {{#if isBrowsed}}
      {{#if isJATO}}
        <otc-icon disableEffects="true" svg="{{jatoCaretIcon}}" isPresentation></otc-icon>
      {{else}}
        <otc-icon disableEffects="true" isPresentation icon="smart_action:action_caret_right32"></otc-icon>
      {{/if}}
    {{/if}}
  </span>
  {{/unless}}
  {{/if}}
  {{#if showInlineActionBar}}
  <div class="csui-list-inlineactions-btn"></div>
  {{/if}}
</span>
