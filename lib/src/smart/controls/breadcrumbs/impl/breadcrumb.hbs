{{#if hasSubCrumbs}}

  {{#if isJATO}}
    <otc-button class="csui-subcrumb csui-acc-focusable" size="small" type="link" tabindex="-1" arialabel="{{subcrumbAria}}" title="{{subcrumbTooltip}}" id="smart-breadcrumb-more-{{btnId}}">
      <otc-icon type="secondary" svg="{{moreSVGContent}}"></otc-icon>
    </otc-button>
  {{else}}
    <otc-button icon="smart_action_16:action_more16" class="csui-subcrumb csui-acc-focusable" tabindex="-1" arialabel="{{subcrumbAria}}" title="{{subcrumbTooltip}}" iconappearance="{{bcMoreBtnTheme}}" id="smart-breadcrumb-more-{{btnId}}"></otc-button>
  {{/if}}

  <otc-menu buttonid="smart-breadcrumb-more-{{btnId}}" scrollable="">
    {{#each subcrumbs}}
      {{#if inactive}}
        <otc-menuitem data-id="{{this.id}}" title="{{this.name}}">{{this.name}}</otc-menuitem>
      {{else}}
        <otc-menuitem class='csui-breadcrumb csui-acc-focusable' href="{{this.url}}" title="{{this.name}}" data-id="{{this.id}}">{{this.name}}</otc-menuitem>
      {{/if}}
    {{/each}}
  </otc-menu>
{{else}}
  {{#if inactive}}
    <span title="{{name}}" {{#if honorCustomizations}} {{#unless isJATO}} {{{styleObj}}} {{/unless}} {{/if}}>{{name}}</span>
  {{else}}
    {{#if isJATO}} 
    <otc-link {{{styleObj}}} class='csui-breadcrumb csui-acc-focusable {{#if isHome}} csui-home-breadcrumb {{/if}}'
        ignorevisited href="{{url}}" data-id="{{id}}" 
       title="{{name}}" arialabel="{{name}}" {{#if isHome}} size="small"{{/if}} lighter>
        {{#if isHome}}
            <otc-icon svg="{{homeSVFContent}}" isPresentation ></otc-icon>
        {{else}}
        <otc-text overflowmode="ellipsis">
            {{name}}
        </otc-text>
        {{/if}}
    </otc-link>
{{else}}
 <a {{{styleObj}}} class='csui-breadcrumb csui-acc-focusable {{#if isHome}} csui-home-breadcrumb {{/if}}'
        href="{{url}}" data-id="{{id}}" tabindex="-1"
       title="{{name}}" aria-label="{{name}}">
      {{#if isHome}}
          <otc-icon icon="smart_action:action_home32" iconappearance="{{bcMoreBtnTheme}}" isPresentation></otc-icon>
      {{else}}
        {{name}}
      {{/if}}
    </a>
  {{/if}}
  {{/if}}
{{/if}}

