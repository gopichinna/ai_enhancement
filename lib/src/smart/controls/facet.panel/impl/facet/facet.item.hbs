<div class="csui-facet-item-checkbox {{showOnHover}}">
    <otc-checkbox interactiveonly="" type="checkbox" class="csui-checkbox" title="{{checkboxTitle}}" arialabel="{{checkboxAriaLabel}}" tabindex="-1">{{checkboxTitle}}</otc-checkbox>
</div>
<div class="csui-filter-name" tabindex="-1" title="{{filterTitle}}" role="button">
  <div class="csui-name">{{name}}</div>
  {{#if displayCount}}
    <div class="csui-total">{{count}}</div>
  {{/if}}
</div>

