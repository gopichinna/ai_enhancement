{{#if showPageSizeMenu}}
  <div class="expanded-pager pager-filter csui-pagesize-menu">
    <div class="smart-dropdown csui-dropdown">
      <otc-button type="{{buttonType}}" size="{{buttonSize}}" class="smart-dropdown-toggle" title="{{pageSizeMenuAria}}" id="menuButton" arialabel="{{pageSizeMenuAria}} {{totalItemsAria}}">
        <span class="csui-pageSize">{{itemsPerPage}}</span>
        {{#if isJATOTheme}}
          <otc-icon svg="{{jatoIcons.actionChevronSmallDown}}" isPresentation></otc-icon>
        {{else}}
          <otc-icon icon="smart_action_16:action_caret_down16" isPresentation></otc-icon>
        {{/if}}
      </otc-button>
      <otc-menu buttonId="menuButton" alignment="left" class="smart-dropdown-menu csui-dropdown-list" role="none" forceopenup>
        <otc-menugroup class="smart-menu-group">
        {{#each items}}
        <otc-menuradio class="{{className}}" data-pagesize="{{ddListItem}}" {{ariaCurrent}}
        arialabel="{{ariaTxt}}" {{checked}}>{{txt}}</otc-menuradio>
        {{/each}}
        </otc-menugroup>
      </otc-menu>
    </div>
  </div>
{{/if}}
  <div></div>
  <div class="csui-pagination binf-pagination">
    <div class="csui-paging-navbar">
      <ul class="binf-hidden">
        <li class="csui-overflow"></li>
      </ul>
    </div>
  </div>
<div class="csui-total-container-items">{{totalItems}}</div>

