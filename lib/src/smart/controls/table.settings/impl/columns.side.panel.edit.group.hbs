{{#unless haveOnlyUngrouped}}<h3 class="columns-side-panel-edit-group-header {{#if expanded}}group--is-expanded{{/if}}">
  <button class="columns-side-panel-edit-group-button" aria-expanded="{{expanded}}" aria-controls="{{groupId}}">
    {{#if isJato}}
      <otc-icon size="16" isPresentation svg="{{svgCaret}}" type="subtle"></otc-icon>
      <span>{{name}}</span>
    {{else}}
      <span>{{name}}</span>
      <otc-icon isPresentation {{#if expanded}}icon="smart_action:action_caret_up32"{{else}}icon="smart_action:action_caret_down32"{{/if}}></otc-icon>
    {{/if}}
  </button>
</h3>{{/unless}}
<div class="columns-side-panel-edit-group-children-region"></div>

