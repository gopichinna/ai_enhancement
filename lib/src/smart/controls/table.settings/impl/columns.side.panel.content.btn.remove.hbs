{{#if isJato}}
  <otc-button type="subtle" size="small" {{#unless tabstop}}tabindex="-1" {{/unless}}
              class="smart-table-settings-column-btnRemove">
    <otc-icon svg="{{closeXsSvg}}"></otc-icon>
  </otc-button>
{{else}}
  {{#if active}}
    <otc-button {{#unless tabstop}}tabindex="-1" {{/unless}}class="smart-table-settings-column-btnRemove" icon="smart_action:action_close_mid32"></otc-button>
  {{else}}
    <otc-icon isPresentation class="smart-table-settings-column-btnRemove" icon="smart_action:action_close_mid32"></otc-icon>
  {{/if}}
{{/if}}

