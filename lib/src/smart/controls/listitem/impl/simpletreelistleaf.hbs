<div class="binf-list-group-item">
  {{#if enableIcon}}<div class="csui-type-icon csui-icon {{icon}}"></div>{{/if}}
  <div role="link" title="{{#if tooltip}}{{tooltip}}{{else}}{{name}}{{/if}}" class="list-item-title"
    aria-label="{{itemLabel}}">{{name}}</div>
  {{#if showInlineActionBar}}<div class="csui-tileview-more-btn"></div>{{/if}}
</div>
