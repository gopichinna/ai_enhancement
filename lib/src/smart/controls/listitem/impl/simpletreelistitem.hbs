<div class="cs-header binf-panel-heading" tabindex="-1">
  {{#if icon}}
  <span class="csui-button-icon container-icon {{icon}}"></span>
  {{/if}}
  <div class="cs-title" title="{{#if tooltip}}{{tooltip}}{{else}}{{name}}{{/if}}">{{name}}</div>
  <otc-icon icon="smart_action:action_caret_up32" disableeffects class="smart-icon-expandArrowUp binf-hidden"
      title="{{collapseLabel}}"  arialabel="{{collapseLabel}}"></otc-icon>
  <otc-icon icon="smart_action:action_caret_down32" disableeffects class="smart-icon-expandArrowDown"
      title="{{expandLabel}}"  arialabel="{{expandLabel}}"></otc-icon>
</div>

<div
  class="cs-content csui-normal-scrolling {{#unless expand}} binf-hidden{{/unless}} {{#if flatten}} binf-hidden{{/if}}">
  <div role="group" class="cs-list-group"></div>
</div>
