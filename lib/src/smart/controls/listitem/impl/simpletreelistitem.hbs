<div class="cs-header binf-panel-heading" tabindex="-1">
  {{#if icon}}
    {{#if jatoGroupIcon}}
      <span class="smart-tree-list-group-icon">
        <otc-icon size="24" type="raw" svg="{{jatoGroupIcon}}"></otc-icon>
      </span>
    {{else}}
      <span class="csui-button-icon container-icon {{icon}}"></span>
    {{/if}}
  {{/if}}
  <div class="cs-title core" title="{{#if tooltip}}{{tooltip}}{{else}}{{name}}{{/if}}">{{name}}</div>
  {{#if isJATO}}
      <otc-icon class="smart-icon-expandArrowUp jatx-caret-icon binf-hidden" svg="{{collapseSVGContent}}" title="{{collapseLabel}}"  arialabel="{{collapseLabel}}"></otc-icon>
      <otc-icon class="smart-icon-expandArrowDown jatx-caret-icon" svg="{{expandSVGContent}}" title="{{expandLabel}}"  arialabel="{{expandLabel}}"></otc-icon>
  {{else}} 
      <otc-icon class="smart-icon-expandArrowUp core2 binf-hidden" icon="smart_action:action_caret_up32" disableeffects 
      title="{{collapseLabel}}"  arialabel="{{collapseLabel}}"></otc-icon>
      <otc-icon class="smart-icon-expandArrowDown" icon="smart_action:action_caret_down32" disableeffects 
        title="{{expandLabel}}"  arialabel="{{expandLabel}}"></otc-icon>
  {{/if}}
</div>

<div class="cs-content csui-normal-scrolling {{#unless expand}} binf-hidden{{/unless}} {{#if flatten}} binf-hidden{{/if}}">
  <div role="group" class="cs-list-group"></div>
</div>
