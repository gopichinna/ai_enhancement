<a class="binf-list-group-item" title="{{name}}" {{#if nameTitleAria}} aria-label="{{nameTitleAria}}" {{/if}}>
    {{#if enableIcon}}
    {{#if icon}}
    <span class="csui-type-icon csui-icon {{icon}}"></span>
    {{else if iconName}}
    {{{icon-v2 iconName=iconName states=v2Icon.states size=v2Icon.size}}}
    {{/if}}
    {{/if}}
    <div title="{{name}}" class="list-item-title">{{name}}</div>
</a>
