{{#unless noHeader}}
<div class="tile-header">
  {{#if icon}}
    <div class="tile-type-icon">
      {{#if smartTileHeaderJatoIcon}}
        <span class="smart-tile-header-jato-icon">
          <otc-icon type="raw" size="24" svg="{{smartTileHeaderJatoIcon}}"></otc-icon>
        </span>
      {{else}}
        <span class="icon {{icon}}"></span>
      {{/if}}
    </div>
  {{else}}
  {{#if imageUrl}}
  <div class="tile-type-image {{imageClass}}">
    <span class="tile-type-icon tile-type-icon-img"><img src="{{imageUrl}}" alt="{{expandAria}}"></span>
  </div>
  {{/if}}
  {{/if}}

  <div class="tile-title" title="{{title}}">
    <h2 class="csui-heading">{{title}}</h2>
    {{#if enableSubtitle}}
    <div class="smart-list-header-subtitle">{{listHeaderSubtitle}}</div>
    {{/if}}
  </div>

  <div class="tile-controls">
    <div class="tile-icons">
      {{^if hideSearch}}
      <otc-typeahead-search class="smart-list-search" title="{{searchAria}}" arialabel="{{searchAria}}">
        <otc-input type="search" slidein="" class="smart-list-search-input" placeholder="{{searchPlaceholder}}" title="{{searchTitle}}" arialabel="{{searchAria}}" autocomplete="off" cleariconarialabel="{{clearAll}}" clearicontitle="{{clearAllAria}}" closeiconarialabel="{{searchCloseAria}}" closeicontitle="{{searchCloseAria}}"></otc-input>
      </otc-typeahead-search>
      {{/if}}
      {{#if enableExpand}}
      {{#if isJato}}
      <otc-button class="cs-icon cs-open-perspective-button" title="{{openPerspectiveAria}}"
        arialabel="{{openPerspectiveAria}}">
        <otc-icon type="secondary" svg="{{tileHeaderExapandSVGContent}}"></otc-icon>
      </otc-button>
      {{else}}
      <otc-button icon="smart_action:action_expand32" class="cs-icon cs-open-perspective-button"
        title="{{openPerspectiveAria}}" arialabel="{{openPerspectiveAria}}"></otc-button>
      {{/if}}
      {{/if}}
      </div>
  </div>

</div>
{{/unless}}

<div class="tile-content csui-normal-scrolling">
  <div class="binf-list-group" role='{{listRole}}'></div>
  <div class="binf-sr-only" aria-live="off"></div>
</div>

