<div class="tile-header">

  {{#if icon}}
  <div class="tile-type-icon">
    <span class="icon {{icon}}"></span>
  </div>
  {{else}}
  {{#if imageUrl}}
  <div class="tile-type-image {{imageClass}}">
    <span class="tile-type-icon tile-type-icon-img"><img src="{{imageUrl}}" alt="{{expandAria}}"></span>
  </div>
  {{/if}}
  {{/if}}

  <div class="tile-title" title="{{title}}">
    <h2 class="csui-heading">{{title}}</h2>
  </div>

  <div class="tile-controls">
    <div class="search-box">
      {{^if hideSearch}}
      <span class="icon-search-placeholder">{{{icon-v2 iconName='csui_smart_action_search32'}}}</span>
      <input class="search" type="search" placeholder="{{searchPlaceholder}}" title="{{searchTitle}}">
      <span class="clearer csui-icon formfield_clear" title="{{clearAll}}" aria-label="{{clearAllAria}}"
        role="button"></span>
      <span class="fadeout csui-icon" title="{{searchTitle}}"></span>
      {{/if}}
    </div>

    <div class="tile-icons">
      {{^if hideSearch}}
      <otc-button icon="smart_action:action_search32" class="cs-icon cs-search-button"
      title="{{searchAria}}"  arialabel="{{searchAria}}"></otc-button>
      
      {{/if}}
      {{#if enableOpenPerspective}}
      <otc-button icon="smart_action:action_expand32" class="cs-icon cs-open-perspective-button"
      title="{{openPerspectiveAria}}"  arialabel="{{openPerspectiveAria}}"></otc-button>
      {{/if}}
    </div>

    <div class="close-search-icon">
      {{^if hideSearch}}
      <otc-button icon="smart_action:action_close_mid32" class="cs-icon cs-search-close-button"
       title="{{searchCloseAria}}" aria-label="{{searchCloseAria}}" aria-haspopup="true"></otc-button>
      {{/if}}
    </div>
  </div>

</div>

<div class="tile-content csui-normal-scrolling" role='{{listRole}}'>
  <div class="binf-list-group"></div>
  <div class="binf-sr-only" aria-live="off"></div>
</div>
