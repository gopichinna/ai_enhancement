{{#if title}}
<div
  class="cs-header binf-panel-heading {{#if leftIcon}} cs-header-with-go-back {{else}} cs-header-without-go-back {{/if}}"
  role="link" aria-label="{{goBackAria}}">
  {{#if showBackButton}}
  <div class="smart-simplelist-icon-wrapper smart-v2-icon-parent" role="button">
    <otc-button icon="smart_action:action_back32" class="cs-go-back" title="{{goBackTooltip}}" arialabel="{{goBackAria}}"></otc-button>
  </div>
  {{else if titleBarIcon}}
  <span class="icon circular smart-simplelist-icon {{titleBarIcon}}" title="{{goBackTooltip}}"></span>
  {{/if}}
  <span class="cs-title {{#if leftIcon}} cs-title-with-go-back {{/if}}" title="{{title}}">{{title}}</span>
</div>
{{/if}}

<div class="cs-content csui-normal-scrolling">
  <div class="cs-list-group" {{#if listRole}} role="{{listRole}}" {{/if}} {{#if listAria}} aria-label="{{listAria}}"
    {{/if}}>
  </div>
</div>
