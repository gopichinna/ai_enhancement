<div class="smart-progress-wrapper">
<div class="csui-header {{#if singleItem}}smart-singleitem{{/if}}">
  <div class="csui-progressrow csui-height-target">
    <div class="csui-names-progress">
      <div class="csui-names csui-progresscell">
        <div class="csui-header-icon csui-icon binf-hidden"></div>
        {{#if isJato}}
        <span class="smart-progresspanel-icon binf-hidden"></span>
        {{else}}
        <otc-icon class="smart-progresspanel-icon binf-hidden" isPresentation></otc-icon>
        {{/if}}
        <h2 class="csui-title" id="{{progressTitleId}}">
          {{title}}
        </h2>
      </div>
      <div class="csui-progress csui-progresscell">
        <div class="csui-progress-dynamic binf-hidden">
          <div class="csui-progress-textbar">
            <div class="binf-progress">
              <div class="binf-progress-bar" role="progressbar" aria-valuenow="{{percentage}}"
                   aria-valuemin="0" aria-valuemax="100" style="width:{{percentage}}%">
              </div>
            </div>
            <div class="loading-dots">
                <div class="csui-loading-parent-wrapper binf-disabled csui-disabled">
                    <span class="csui-loading-dots-wrapper">
                        <span class="csui-loading-dot"></span>
                        <span class="csui-loading-dot"></span>
                        <span class="csui-loading-dot"></span>
                    </span>
                </div>
            </div>
          </div>
        </div>
        <div class="csui-progress-static">
          <div class="csui-progress-textbar">
            <div class="csui-progress-static-pending" aria-hidden="true">{{state_pending}}</div>
            <div class="csui-progress-static-processing binf-hidden" aria-hidden="true">{{state_processing}}</div>
            <div class="csui-progress-static-resolved binf-hidden">{{state_resolved}}</div>
            <div class="csui-progress-static-rejected binf-hidden">{{state_rejected}}</div>
            <div class="csui-progress-static-aborted binf-hidden">{{state_aborted}}</div>
          </div>
          <div class="csui-percent"></div>
        </div>
      </div>
    </div>
    <div class="csui-states-actions">
      {{#if enableCancel}}
      <div class="csui-stateaction csui-progresscell">
        <button type="button" aria-label="{{stateaction_all_pending}}"
                class="csui-stateaction-pending
        csui-icon-like-btn binf-btn binf-btn-default" tabindex="-1">{{stateaction_pending}}</button>
        {{#if isJato}}
        <otc-button arialabel="{{stateaction_all_processing}}" class="csui-stateaction-processing binf-hidden" tabindex="-1" size="small" type="secondary">
          {{stopButtonLabel}}
        </otc-button>
        {{else}}
        <button type="button" aria-label="{{stateaction_all_processing}}"
                class="csui-stateaction-processing csui-icon-like-binf-btn binf-hidden binf-btn binf-btn-default" tabindex="-1">
            {{stateaction_processing}}</button>
        {{/if}}
      </div>
      {{/if}}
      {{#if enableRetry}}
        <div class="csui-show-retryAll binf-hidden">
          <button type="button" class="csui-retry-all" title="{{retryAll}}" tabindex='-1'>{{retryAll}}</button>
        </div>
      {{/if}}
      <div class="csui-expand csui-progresscell {{#if singleItem}}binf-hidden{{/if}}">
        {{#if isJato}}
          <otc-button size="small" class="csui-expand-down smart-collapse-expand" arialabel="{{expandAria}}" title="{{expand}}" tabindex="0">
            <otc-icon svg="{{expandSVGContent}}"></otc-icon>
          </otc-button>
          <otc-button size="small" class="csui-expand-up smart-collapse-expand binf-hidden" arialabel="{{collapseAria}}" title="{{collapse}}" tabindex="0">
            <otc-icon svg="{{collapseSVGContent}}"></otc-icon>
          </otc-button>
        {{else}}
          <otc-button class="csui-expand-down smart-collapse-expand" icon="smart_action_16:action_caret_down16" arialabel="{{expandAria}}" title="{{expand}}" tabindex="0"></otc-button>
          <otc-button class="csui-expand-up smart-collapse-expand binf-hidden" icon="smart_action_16:action_caret_up16" arialabel="{{collapseAria}}" title="{{collapse}}" tabindex="0"></otc-button>
        {{/if}}
      </div>
      <div class="csui-close csui-progresscell binf-hidden">
        {{#if isJato}}
          <otc-button size="small" class="csui-action-close csui-icon" arialabel="{{closeAria}}" title="{{close}}" tabindex="-1">
            <otc-icon svg="{{closeSVGContent}}"></otc-icon>
          </otc-button>
        {{else}}
        <button type="button" class="binf-btn binf-btn-default csui-action-close csui-icon"
                aria-label="{{closeAria}}" title="{{close}}" tabindex="-1">
          {{{icon-v2 iconName="csui_smart_ot_action_close_mid32" states="true" size="small"}}}
        </button>
        {{/if}}
      </div>
      {{#if isJato}}
        {{#if enableMinimiseButton}}
          <div class="smart-progress-minimize">
            <otc-button size="small" class="icon-progresspanel-minimize">
              <otc-icon svg="{{actionMinimizeSVGContent}}" isPresentation=""></otc-icon>
            </otc-button>
          </div>
        {{/if}}
      {{/if}}
    </div>
  </div>
  {{#if enhancePanel}}
  {{#if targetLocationUrl}}
  <otc-link class="csui-gotolocation-url binf-hidden" href="{{targetLocationUrl}}" tabindex="-1" ignorevisited="">{{gotoLocation}}</otc-link>
  {{/if}}
  {{/if}}
</div>
<div class="smart-show-all-progress"></div>
<div class="csui-items-wrapper csui-normal-scrolling">
  <div class="csui-items" role="list" aria-label="{{detailsListAria}}"></div>
</div>
</div>

