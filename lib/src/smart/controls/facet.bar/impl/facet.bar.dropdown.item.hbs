{{#if isJATO}}
  <otc-button class="binf-dropdown-toggle facetbarMoreButton" tabindex="-1" arialabel="{{moreButtonsAria}}" title="{{moreButtonsAria}}" size="small" ariaexpanded="false" >
    <otc-icon svg="{{jatoMoreFacetIconSvg}}"></otc-icon>
  </otc-button>
{{else}}
  <otc-button class="binf-dropdown-toggle facetbarMoreButton" tabindex="-1" arialabel="{{moreButtonsAria}}" title="{{moreButtonsAria}}"  
    icon="smart_action:action_more32" ariaexpanded="false" >
  </otc-button>
{{/if}}
<ul class="binf-dropdown-menu csui-dropdown-list csui-facet-bar-dropdown csui-normal-scrolling" aria-label="{{overflowMenuAria}}">
    {{#each collection}}{{/each}}
</ul>
