{{#if isFacetLabel}}
<div class="csui-facet-item-facet-name">{{facetName}}</div>
{{/if}}
{{#if isTopic}}
<div class="csui-facet-item-topic {{#if readOnlyFilter}}smart-facet-item-topic-readonly{{/if}}" aria-label="{{ariaLabel}}" tabindex="-1" {{#if readOnlyFilter}} aria-readonly="true" {{/if}}>
  <span class="csui-facet-item-topic-name" title="{{topicName}}">{{topicName}}</span>
  {{#if enableCloseIcon}}
  <span title="{{clearTitle}}" class="csui-icon smart-facet-close  smart-button-chip" data-csui-facet="{{facetId}}" data-csui-topic="{{topicId}}">
      {{#if isJATO}}
        <otc-button size="small" tabindex="-1" arialabel="{{ariaLabel}}">
          <otc-icon svg="{{jatoCloseIconSvg}}"></otc-icon>
        </otc-button>
      {{else}}
          <otc-button icon="smart_action_16:action_close16" tabindex="-1" arialabel="{{ariaLabel}}"></otc-button>
      {{/if}}
  </span>
  {{/if}}
</div>
{{/if}}

