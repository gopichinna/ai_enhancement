<div class="smart-tab-links-bar-toolbar-wrapper">
  {{#if toolbar}}
    <div class="left-toolbar smart-left-toolbar">
      <div class="goto_previous_div" >
        {{#if isJATO}}
        <otc-button class="cs-icon smart-goto-previous-page" title="{{previousTooltip}}" arialabel="{{previousTooltip}}" tabindex="-1">
          <otc-icon svg="{{jatoLeftArrowIconName}}"></otc-icon>
        </otc-button>
        {{else}}
        <otc-icon disableEffects="true" icon="{{leftArrowIconName}}" class="cs-icon smart-goto-previous-page" 
            title="{{previousTooltip}}" arialabel="{{previousTooltip}}" isPresentation></otc-icon>
        {{/if}}
      </div>
    </div>
  {{/if}}

  <div class="tab-links-bar smart-tab-links-bar">
    <span class="fadeout"></span>
    <ul class="binf-nav {{tab_type}}" role="tablist"></ul>
  </div>

  {{#if toolbar}}
    <div class="right-toolbar smart-right-toolbar">
      <div class="goto_next_div">
        {{#if isJATO}}
        <otc-button class="cs-icon smart-goto-next-page" title="{{nextTooltip}}" arialabel="{{nextTooltip}}" tabindex="-1">
          <otc-icon svg="{{jatoRightArrowIconName}}"></otc-icon>
        </otc-button>
        {{else}}
        <otc-icon disableEffects="true" icon="{{rightArrowIconName}}" class="cs-icon smart-goto-next-page" 
            title="{{nextTooltip}}" arialabel="{{nextTooltip}}" isPresentation></otc-icon>
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>
