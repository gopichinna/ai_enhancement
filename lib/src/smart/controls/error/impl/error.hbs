<div class="csui-error-icon-div">
  <div class="csui-error-icon-parent">
    {{#if isJATO}}
      <div class="smart-error-jato-icon">
        <otc-icon type="raw" svg="{{errorJatoMimeIcon}}" class="smart-error-icon"></otc-icon>
      </div>
    {{else}}
        <div class="csui-error-icon notification_error"></div>
    {{/if}}
  </div>
</div>

<div class="smart-error-message">
  <h2 class="csui-message">{{message}}</h2>
  {{#if suggestion}}
    <p class="csui-suggestion">{{suggestion}}</p>
  {{/if}}
  {{#if detailedMessage}}
    <p class="smart-error-detailed-message">{{detailedMessage}}</p>
  {{/if}}
</div>

<div class="smart-show-more binf-hidden">
  <otc-button type="{{showMoreBtnType}}" size="{{showMoreBtnSize}}" tabindex="0" 
  arialabel="{{showMoreErrorText}}" class="show-more-btn">{{showMoreBtn}}</otc-button>
</div>
