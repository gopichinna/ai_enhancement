{{#if isJATO}}
    {{#if jatoIcon}}
        <otc-icon svg="{{jatoIcon}}" isPresentation></otc-icon>
    {{else}}
        {{btnText}}
    {{/if}}
{{else}}
    {{#if v2Icon}}
        {{{icon-v2 iconName=v2Icon.iconName states=v2Icon.states size=v2Icon.size}}}
    {{else}}
        {{btnText}}
    {{/if}}
{{/if}}
