<div role="alertdialog" class="binf-modal-dialog" aria-describedby="{{dlgMsgId}}">
    <div class="binf-modal-content smart-light-content">
        <div class="smart-light-container {{headerClass}}">
            <div class="smart-light-message">
                {{#if showTitleIcon}}
                {{#if isJATO}}
                    <span class="smart-notification-icon">{{{jatoTitleIcon}}}</span>
                {{else}}
                    <otc-icon class="smart-notification-icon" icon="smart_notification:{{titleIcon}}" isPresentation></otc-icon>
                {{/if}}
                {{/if}}
                <div class="binf-modal-body smart-light-body message-text" id="{{dlgMsgId}}"></div>
            </div>
        </div>
        <div class="binf-modal-footer smart-light-footer"></div>
    </div>
</div>
