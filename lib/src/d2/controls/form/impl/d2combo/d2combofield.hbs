{{#if writeonlyMode}}
  <div class="cs-field-write">
    <div class="cs-field-write-inner">
      <input class="d2-combofield-search-box-input" type="text" tabindex = "0" placeholder="{{emptyLabel}}" value="{{data}}"
             {{#if idBtnLabel}}aria-labelledby="{{idBtnLabel}}"{{/if}}
        {{#if ariaRequired}}aria-required="{{ariaRequired}}"{{/if}} id="{{controlId}}" aria-autocomplete="list"
             role="combobox" name="fsdffsdf" autocomplete="off">
      <span class="d2-icon-caret-down {{#if this.disabled}}d2-icon-disabled {{/if}}"></span>
      </input>
      <div class="{{#if
          showMobileContainer}}d2-combofield-mobile-options-container csui-listview{{/if}} d2-combofield-options-container">
        {{#if showMobileContainer}}
          <div class="csui-search csui-search-prompt d2mobile-inline-search binf-hidden">
            <div class="csui-search-top">
              <div class="csui-input-wrapper">
                  <div class="csui-search-input">
                    <div class="csui-icon icon-search16"></div>
                    <div class="csui-input-before-focus" role="searchbox">{{searchPlaceHolder}}</div>
                    <input type="search" class="csui-input binf-hidden" placeholder="{{searchPlaceHolder}}" required/>
                    <div class="csui-icon icon-formfield-clear16 cancel"></div>
                  </div>
              </div>
            </div>
          </div>
          {{#if isEditable}}
             <ul class="d2-add-new-option" role="listbox">
              <li id="{{addNewId}}" role="option" class="d2-select-add-new-option d2mob-editable-combofield-options-add"><span class="d2-listfield-icon-container"></span>
                  <a tabindex="-1" title="{{addNewLabel}}" class="d2mob-add-new-options">
                   {{addNewLabel}}</a></li>
              </ul>
          {{/if}}
        {{/if}}
        <ul class='d2-lazy-loading'>
          <li role="menuitem" class="csui-loading-parent-wrapper binf-disabled csui-disbaled">
          <span class="csui-loading-dots-wrapper"><span class="csui-loading-dot"></span><span
              class="csui-loading-dot"></span><span
              class="csui-loading-dot"></span></span>
          </li>
        </ul>
        <div class="d2-scrollable-options">
          <ul class="d2-combofield-options d2-combofield-options-list" role="listbox">
            <li class="d2-searchResultCountDetails d2-combo-results-message">{{dropDownSearchResultCount}}</li>
            <li class="d2-none-item"><a tabindex="-1" title="{{name}}">
              <span class="d2-listfield-icon-container"></span>
              <span class="d2-listfield-text-container">{{noneLabel}}</span>
            </a></li>
          </ul>
        </div>
        {{#if isEditable}}
          <ul class="d2-add-new-option" role="listbox">
            <li id="{{addNewId}}" role="option" class="d2-select-add-new-option"><a tabindex="-1"
                                                                                    title="{{addNewLabel}}">
              <span class="d2-listfield-icon-container"></span> {{addNewLabel}}</a></li>
          </ul>
        {{/if}}
      </div>
    </div>
  </div>
{{else}}
  <div class="cs-field-read">
    <div class="cs-field-read-inner">
      <div class="btn-container">
        <button {{#if isReadOnly}} aria-disabled="true" {{/if}} aria-label="{{readModeAria}}"
          {{#if this.hasData}}
                                   title="{{name}}"
          {{else}}
                                   title="{{noValue}}"
          {{/if}}>
          {{#if this.hasData}}
            <span class="selected-label" data-id="{{dataId}}">{{data}}</span>
          {{else}}
            <span class="selected-label placeholder">
              {{emptyLabel}}</span>
          {{/if}}
        </button>
      </div>
    </div>
  </div>
{{/if}}

