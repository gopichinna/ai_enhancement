{{#if readOnlyMode}}
<div class="read-mode">{{{data}}}<div>
{{else}}
<div class="write-mode">
    <div class="editor-wrapper">
        <textarea class="rich-text-field binf-hidden">{{data}}</textarea>
    </div>
    <div class="message-wrapper">
        <div class="error-message binf-hidden"></div>
        <div class="rich-text-content-length" ></div>
    </div>
</div>
{{/if}}
