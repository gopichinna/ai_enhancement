{{#if writeonlyMode}}
<div class="cs-field-write">
  <div class="cs-field-write-inner">
    <input type="password" id="{{id}}" name="{{name}}" value="{{data}}" autocomplete="off">
  {{#if showOrHidePassword}}
    <span class="d2-icon-password-icon" tabindex="0"></span>
  {{/if}}
  </div>
</div>
{{/if}}
<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <div class="btn-container">
      <button {{#if schema.readonly}}tabindex="-1" data-cstabindex="-1"{{/if}}
        {{#if idBtnLabel}} aria-labelledby="{{idBtnLabel}}" {{/if}}>
        {{#if this.hasData}}
          <span>*****</span>
        {{else}}
          <span class="placeholder"
                title="{{noValue}}">{{emptyLabel}}</span>
        {{/if}}
      </button>
    </div>
  </div>
</div>

