{{#if showMobileContainer}}
<div class="d2mobile-header binf-hidden">
  <div class="csui-search csui-search-prompt d2mobile-inline-search">
    <div class="csui-search-top">
      <div class="csui-input-wrapper">
          <div class="csui-search-input">
            <div class="csui-icon icon-search16"></div>
            <div class="csui-input-before-focus" role="searchbox">{{searchPlaceHolder}}</div>
            <input type="search" class="csui-input binf-hidden" placeholder="{{searchPlaceHolder}}" required/>
            <div class="csui-icon icon-formfield-clear16 cancel"></div>
          </div>
      </div>
    </div>
  </div>
  {{#if isEditableList}}
      <ul class="d2-add-new-option" role="listbox">
          <li id="{{addNewId}}" role="option" class="d2-select-add-new-option d2mob-editable-combolist-options-add">
              <span class="d2-listfield-icon-container"></span>
              <a tabindex="-1" title="{{addNewLabel}}" class="d2mob-combolist-add-new">{{addNewLabel}}</a></li>
      </ul>
  {{/if}}
  {{#if showInfo}}
  <div class="infoMsgContainer">
    <span class="notification_information"></span>
    <span class="infoMsg">{{infoMsg}}</span>
  </div>
  {{/if}}
</div>
{{/if}}
<ul class='d2-lazy-loading'>
  <li role="menuitem" class="csui-loading-parent-wrapper binf-disabled csui-disbaled">
    <span class="csui-loading-dots-wrapper"><span class="csui-loading-dot"></span><span class="csui-loading-dot"></span><span
        class="csui-loading-dot"></span></span>
  </li>
</ul>
<ul class='d2-listfield-options'>
  <li class="d2-searchResultCountDetails d2-list-results-message" tabindex="0" aria-label="{{dropDownSearchResultCount}}">{{dropDownSearchResultCount}}</li>
  <li class="d2-none-item"><a tabindex="-1" title="{{noneLabel}}">
    <span class="d2-listfield-icon-container"></span>
    <span class="d2-listfield-text-container">{{noneLabel}}</span>
  </a></li>
</ul>
{{#if isEditableList}}
  <ul class="d2-add-new-option" role="listbox">
    <li id="{{addNewId}}" role="option" class="d2-select-add-new-option"><a tabindex="-1" title="{{addNewLabel}}">
      <span class="d2-listfield-icon-container"></span> {{addNewLabel}}</a></li>
  </ul>
{{/if}}

