{{#if showButtonInReadMode}}
  <button aria-disabled="true" title="{{name}}">
    <span title="{{name}}">{{name}}</span>
  </button>
{{else}}
  <a tabindex="-1" title="{{name}}">
  {{#if isNotShowHorizontal}}
       <span class="d2-listfield-icon-container {{#if isSortable}}d2-icon-drag{{/if}}"></span>
  {{/if}}
  {{#if showOptionsInHierarchy}}
      <span class="d2-listfield-selectedlabel">{{hierarchyItemLabel}}</span>
  {{else}}
      <span class="d2-listfield-selectedlabel">{{name}}</span>
  {{/if}}
   {{#if isNotReadMode}}
      <span class="d2-listfield-icon-container d2-remove-selectedValue d2-icon-selected-close"></span>
       {{/if}}
  </a>
{{/if}}
