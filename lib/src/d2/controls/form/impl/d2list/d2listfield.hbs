{{#if writeonlyMode}}
  <div class="cs-field-write">
    <div class="cs-field-write-inner">
      <div class="d2-listfield-search-box"></div>
      <div class="d2-listfield-selected-container"></div>
      {{#if isMobile}}
        <div class="drop-down-button binf-hidden"></div>
      {{/if}}
      <div class="d2-listfield-options-container"></div>
    </div>
  </div>
{{else}}
  <div class="cs-field-read">
    <div class="cs-field-read-inner">
      <div class="d2-listfield-selected-container"></div>
    </div>
  </div>
{{/if}}

