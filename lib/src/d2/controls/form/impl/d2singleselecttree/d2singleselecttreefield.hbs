{{#xif "this.mode === 'writeonly'"}}
  <div class="cs-field-write">
    <div class="cs-field-write-inner">
    <input readonly type="{{inputType}}" id="{{id}}"
           placeholder="{{browseTitle}}"
      {{#if options.size}}size="{{options.size}}"{{/if}}
      {{#if options.nameIdentifier}}name="{{options.nameIdentifier}}"{{/if}}
      {{#each options.data}}data-{{@key}}="{{this}}"{{/each}}
      {{#each options.attributes}}{{@key}}="{{this}}"{{/each}}
      value="{{data}}" {{#if idBtnLabel}}aria-labelledby="{{idBtnLabel}}" {{/if}}
      {{#if ariaRequired}} aria-required="{{ariaRequired}}"{{/if}}
      title="{{tooltip}}"
      aria-label="{{tooltip}}"
      autocomplete="off"/>
      {{#if this.enabled}}
        <span id="openSelectionDialogBtn" role="button" aria-label="{{browseTitle}}" tabindex="0" class="icon-select-dialog"
              title="{{browseTitle}}"></span>
      {{/if}}
    </div>
  </div>
{{/xif}}
<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <div class="btn-container">
      <button title="{{tooltip}}"{{#if schema.readonly}} aria-disabled="true" {{/if}} aria-label="{{readModeAria}}">
        {{#if this.hasData}}
          <span>{{data}}</span>
        {{else}}
          <span class="placeholder" title="{{noValue}}">{{emptyLabel}}</span>
        {{/if}}
      </button>
    </div>
  </div>
</div>

