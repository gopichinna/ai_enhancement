<div class="d2-group-name" title="{{name}}">{{name}}</div>
{{#if indicateRequired}}
  <div class="d2-group-required"></div>
{{/if}}
{{#if subtitle}}
  <div class="d2-group-subtitle" title="{{subtitle}}">{{subtitle}}</div>
{{/if}}
<div class="d2-group-expandCollapse {{#if initialExpand}}collapse{{else}}expand{{/if}}"
     title="{{#if initialExpand}}{{collapseTitle}}{{else}}{{expandTitle}}{{/if}}" tabindex="0"></div>
<div class="d2-group-separator"></div>
