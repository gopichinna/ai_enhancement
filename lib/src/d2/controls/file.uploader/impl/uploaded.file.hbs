<div class="file-icon"></div>
<div class="file-details">
  <div class="file-name" title="{{name}}" aria-label="{{name}}">{{name}}</div>
  {{#if sizeValue}}
  <div class="file-size" title="{{sizeLabel}} {{sizeValue}}" aria-label="{{sizeLabel}} {{sizeValue}}">
    <span class="size-lable">{{sizeLabel}}</span>
    <span class="size-value">{{sizeValue}}</span>
  </div>
  {{/if}}
{{#if haveErrorMessage}}
  <div class="csui-inlineform-group-error" role="alert" id="{{errorMsgId}}">
    <div class="binf-text-danger" role="alert" title="{{errorMessage}}"><span class="csui-text-danger">{{errorMessage}}</span></div>
  </div>
{{else}}
  <div class="file-format">
    <div class="format-lable">{{fileFormatLabel}}</div>
    <div class="format-value" style="display:none"></div>
    <div class="format-menu"></div>
  </div>
{{/if}}
</div>
