<div class="binf-modal-dialog{{#if suppressHeader}} no-header{{/if}}{{#if suppressFooter}} no-footer{{/if}}" role="dialog" aria-hidden="false">
  <div class="binf-modal-content">
    {{#unless suppressHeader}}<div class="binf-modal-header"></div>{{/unless}}
    <div class="binf-modal-body"></div>
    {{#unless suppressFooter}}<div class="binf-modal-footer"></div>{{/unless}}
  </div>
</div>

