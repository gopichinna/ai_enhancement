<otc-button class="d2-otc-btn form-btn search" type="primary" button-id="search"
            action-name="search" ariaLabel="{{search}}" title="{{search}}" tabindex="0">{{search}}</otc-button>
<otc-button class="d2-otc-btn form-btn reset" type="secondary" button-id="reset"
            action-name="reset" ariaLabel="{{reset}}" title="{{reset}}" tabindex="0">{{reset}}</otc-button>
<otc-button class="d2-otc-btn form-btn save" type="secondary" button-id="save"
            action-name="save" ariaLabel="{{save}}" title="{{save}}" tabindex="0">{{save}}</otc-button>
