<div class="csui-header csui-height-target">
  <div class="csui-state">
    <span class="csui-state-icon csui-icon csui-icon-notification-success-white"></span>
  </div>
  <div class="csui-text node-name {{#if linkActive}}link-active{{/if}}" id="{{headerId}}" title="{{title}}">{{message}}<a class="node-done-command-link">{{linkLabel}}</a></div>
  <div class="csui-action">
    <button type="button" class="csui-action-close binf-btn binf-btn-default csui-icon csui-icon-dismiss-white" title="{{lang.CloseDialog}}" aria-label="{{lang.closeDialogAria}}">
     {{{icon-v2 iconName="csui_smart_ot_action_close_mid32" states="true" size="small"}}}
    </button>
  </div>
</div>

