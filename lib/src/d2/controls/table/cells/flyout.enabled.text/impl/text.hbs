{{#if isEmpty}}
  <div class="csui-table-cell-text" aria-label="{{value}}">
    <span class="span-text"> </span>
  </div>
{{else}}
  <div class="csui-table-cell-text" title="{{value}}">
    <span class="span-text">{{value}}</span>
  </div>
{{/if}}

