<div class="av4r-assignment-children-count {{addlContainerClassname}}">
    <span class="av4r-progress-track">
    <span class="av4r-progress-state" role="progressbar" aria-valuenow="{{percentage}}" aria-valuemin="0"
          aria-valuemax="100" style="width:{{percentage}}%"></span>
    </span>
    <span class="count-value" title="{{title}}" tabindex="0">{{data}}</span>
</div>


