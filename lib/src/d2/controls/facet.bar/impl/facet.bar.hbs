<div class="d2-facet-list-bar">
  <div class="d2-mover d2-overflow-left binf-hidden">
    <a href="#" title="{{previous}}" aria-label="{{previous}}">
      <span class="d2-icon goto_previous_page"  ></span>
    </a>
    <span class="d2-facet-list-fade d2-facet-list-fadein"></span>
  </div>

  <div class="d2-facet-list-area"></div>

  <div class="d2-mover d2-overflow-right binf-hidden">
    <span class="d2-facet-list-fade d2-facet-list-fadeout"></span>
    <a href="#" title="{{next}}" aria-label="{{next}}">
      <span class="d2-icon goto_next_page" ></span>
    </a>
  </div>
</div>

<a href="#" class="d2-clear-all binf-hidden" role="button" aria-label="{{clearAllAria}}">
  <div class='cs-icon binf-close'></div>
  <div class='clear-label'>{{clearAll}}</div>
</a>


