<div class="d2-metadata-edit-properties-buttons">
  <otc-button class="d2-otc-btn d2-metadata-edit-properties-edit-button" type="secondary" title="{{edit}}" ariaLabel="{{edit}}" tabindex="0">{{edit}}</otc-button>
  <otc-button class="d2-otc-btn d2-metadata-edit-properties-next-button" type="primary" title="{{next}}" ariaLabel="{{next}}" tabindex="0">{{next}}</otc-button>
  <otc-button class="d2-otc-btn d2-metadata-edit-properties-save-button" type="{{saveButtonType}}" title="{{save}}" ariaLabel="{{save}}" tabindex="0">{{save}}</otc-button>
  <otc-button class="d2-otc-btn d2-metadata-edit-properties-cancel-button" type="{{cancelButtonType}}" title="{{cancel}}" ariaLabel="{{cancel}}" tabindex="0">{{cancel}}</otc-button>
</div>
