<div class="cs-form binf-row metadata-pane-container">
  {{#each fields}}
    {{#if this.isSetType}}
      <div class="binf-col-md-12 cs-form-singlecolumn csui-form-set-array-wrapper cs-form-set"
           id="csfSingleCol_{{../modelId}}{{@index}}"></div>
    {{else if this.isContainerType}}
      <div class="binf-col-md-12 d2-spy-container cs-form-singlecolumn csui-form-set-array-wrapper"
           id="csfSingleCol1_{{../modelId}}{{@index}}"></div>
    {{else}}
      <div class="binf-col-md-6 cs-form-doublecolumn cs-form-leftcolumn"
           id="csfLeftCol_{{../modelId}}{{@index}}"></div>
      <div class="binf-col-md-6 cs-form-doublecolumn cs-form-rightcolumn"
           id="csfRightCol_{{../modelId}}{{@index}}"></div>
    {{/if}}
    {{#if @last}}
      <div class="binf-col-md-12 csui-form-set-array-wrapper d2-last-tab-panel"></div>
    {{/if}}
  {{/each}}
  <div class="csui-extra-general-fields"></div>
  <div class="csui-action-fields"></div>
</div>
