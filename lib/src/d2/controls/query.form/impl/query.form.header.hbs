<div class="title" title="{{title}}">{{title}}</div>
{{#if showClose}}
  <div class="cs-close" title="{{close}}"
       tabindex="0" aria-label="{{close}}" role="button">
    <div class="icon circular d2-queryform-close"></div>
  </div>
{{/if}}
{{#if allowNewSearchAction}}
    <div class = "queryform-header-view-new-search" >
        <span class = "queryform-header-view-new-search-text">{{newSearch}} </span>
    </div>
{{/if}}
