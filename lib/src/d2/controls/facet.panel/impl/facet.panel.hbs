{{#if showTitle}}
  <div class="cs-header binf-panel-heading">
    <span title="{{title}}" class="cs-title">{{title}}</span>
  </div>
{{/if}}
<div class="d2-facet-serverfilter binf-hidden">
  <i class="d2-facet-serverfilter-exclamation-sign"></i>
  <span class="d2-facet-serverfilter-message"></span>
</div>

<div class="cs-content">
  <div class="cs-list-group"></div>
     <div class="d2-facet-noresults-panel" role="button" aria-expanded="false" >
       <span class="icon d2-icon-noresults"></span>
       <div class="d2-facet-noresultstxt">{{noResultsFound}}</div>
     </div>
</div>



