<div class="d2-facet-header">
  <div class="header-label" title="{{name}}">{{name}}</div>
  <div class="header-count" title="{{count}}"> {{count}}</div>
  <span class="d2-facet-search">
    <input type="search" class="d2-facet-search-input binf-hidden"
          placeholder="{{search_placeholder}}"  title="{{search_placeholder}}" value="{{search_value}}">

    <span class="sbclearer close" role="button" aria-expanded="false"
          title="{{search_clear_icon_tooltip}}" aria-label="{{search_clear_icon_tooltip}}"></span>

    <div class="d2-facet-search-icon" role="button" aria-expanded="false"
         aria-label="{{search_icon_tooltip}}" title="{{search_icon_tooltip}}">
      <span class="icon d2-icon-search"></span>
    </div>

  </span>
  <div class="cs-icon csui-button-icon icon-expandArrowUp" role="button" title="{{showFacetAria}}" aria-label="{{showFacetAria}}" tabindex="-1"></div>
</div>

<div class="d2-facet-content {{show-content}}" role="listbox" aria-label="{{listboxAria}}">
  <div class="d2-facet-noresults" role="button" aria-expanded="false" >
    <span class="icon d2-icon-noresults"></span>
    <div class="d2-facet-noresultstxt">No results found </div>
  </div>
  <div class="cs-filter-group"></div>

</div>

