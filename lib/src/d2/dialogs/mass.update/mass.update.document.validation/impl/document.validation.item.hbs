<table class="error-items">
    <div class="table-header">
        <div class="body-message">{{headerMessage}}</div>
        {{#if showCopyIcon}}<div class="d2-validation-copy" title="{{copyTooltip}}" tabindex="0">{{{icon-v2 iconName='csui_action_copy32' states='true'}}}</div>{{/if}}
        {{#if showExpandButton}}
        <div class="expand-collase-button icon expand" title="{{expandTooltip}}"  tabindex="0">
        </div>
        {{/if}}
    </div>
  {{#each errorNodeItems}}
    <tr data-cs-id="{{id}}" data-cs-status="{{status}}" class="error-detail-row" tabindex="0">
      <td class="type"><span class="{{iconClass}}"></span></td>
      <td class="name" title="{{name}}">{{this.name}}</td>
      {{#if this.showVersionLabel}}<td class="version-info"><div class="version-label">{{this.r_version_label}}</div></td>{{/if}}
      <td class="error-data">
        <div class="each-error">
          <div class="status">
            <div class="status-icon"></div>
          </div>
          <div class="message" title="{{message}}">{{this.message}}</div>
        </div>
      </td>
    </tr>
  {{/each}}
</table>
{{#if showFilesInfo}}
    <div class="show-file-Info">
      <div class="info-icon"></div>
      <div class="files-info-message">{{filesInfoMessage}}</div>
    </div>
  {{/if}}
  {{#if showMore}}
    <div class="show-more"  tabindex="0" title="{{showMoreLabel}}">
      <div class="show-more-label">{{showMoreLabel}}</div>
      <div class="show-more-icon"></div>
    </div>
  {{/if}}
