<label class="d2-signature-signee-label" title="{{signee_label}}">{{signee_label}}</label>
<div class="d2-signature-signee-container">
  <input class='d2-signature-signee' type="text" placeholder="{{signee_placeholder}}">
  <span class="d2-signature-caret-down"></span>
  <ul class='d2-lazy-loading'>
    <li role="menuitem" class="csui-loading-parent-wrapper binf-disabled csui-disbaled">
          <span class="csui-loading-dots-wrapper"><span class="csui-loading-dot"></span><span
              class="csui-loading-dot"></span><span
              class="csui-loading-dot"></span></span>
    </li>
  </ul>
</div>
<label class="d2-signature-signee-email-label" title="{{email_label}}">{{email_label}}</label>
<div class="d2-signature-signee-email-container">
  <input class='d2-signature-signee-email' type="text" placeholder="{{email_placeholder}}">
  <span class="d2-signature-caret-down"></span>
  <ul class='d2-lazy-loading'>
    <li role="menuitem" class="csui-loading-parent-wrapper binf-disabled csui-disbaled">
          <span class="csui-loading-dots-wrapper"><span class="csui-loading-dot"></span><span
              class="csui-loading-dot"></span><span
              class="csui-loading-dot"></span></span>
    </li>
  </ul>
</div>
<div class="d2-signature-signee-inline-error binf-hidden"></div>
<div class="d2-signature-signee-form-buttons">
  <div tabindex="0" title="{{add_tooltip}}" class="d2-signature-signee-add"></div>
  <div tabindex="0" title="{{cancel_tooltip}}" class="d2-signature-signee-cancel"></div>
</div>
