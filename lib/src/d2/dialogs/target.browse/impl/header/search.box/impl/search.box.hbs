<div class="search-bar">
  <div class="search-bar-content">
    <div class="d2-search-input-container">
      <input type="search" class="d2-input d2-acc-focusable"
             title="{{messages.searchBoxTitle}}" tabindex="0"
             data-cstabindex="-1" aria-label="{{messages.searchBoxTitle}}"  data-value="">
      <span class="icon close_icon_target_browse close-icon" title="{{messages.clearTooltip}}" aria-label="{{messages.clearTooltip}}" role="button" tabindex="0"></span>
      <span id="tb-search-placeholder" class="d2-text-placeholder">{{{messages.placeholder}}}</span>
      <div class="transitional-content">
      </div>
      <div class="d2-search-options-dropdown">
      </div>
    </div>
    <span class="csui-clearer formfield_clear csui-acc-focusable" title="{{messages.clearerTitle}}"
        aria-label="{{messages.clearerTitle}}" role="button" tabindex="0" data-cstabindex="-1"></span>
  </div>
</div><a
         class="d2-header-search-icon csui-acc-focusable"
         title="{{messages.searchIconTitle}}" aria-label="{{messages.searchIconAria}}"
         tabindex="0" data-cstabindex="-1" role="button" aria-haspopup="true" aria-expanded="false">
         <span class="close_icon icon icon-header-search"  role="link" ></span>
         </a>

