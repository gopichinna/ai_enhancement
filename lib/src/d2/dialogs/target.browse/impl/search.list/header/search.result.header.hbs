<div class="csui-search-header">
    <span class="csui-search-header-title">
        <span class="results-title searchResultsTitle" title="{{messages.searchResults}}">{{messages.searchResults}}</span>
        <span class="headerCount searchHeaderCount" aria-live="polite"></span>
    </span>
    {{#if hasMoreRecords}}
      <div role="button" class="d2-total-notification-icon" aria-label="{{moreRecordTitle}}" title="{{moreRecordTitle}}">
        <span class="icon d2-totalItem-icon-notification"></span>
      </div>
    {{/if}}
</div>

