<div class="addon-container settings-container">
  <div class="addon-header user-settings-header">{{addonHeader}}</div>
  <div class="addon-description user-settings-description">{{addonDescription}}</div>
  <div class="addon-enable toggle-switch-container">
    <div class="toggle-switch">
      <div class="addon-enable-label toggle-switch-label">{{addonEnableLabel}}</div>
      <div class="addon-enable-switch"></div>
    </div>
    <div class="error-panel binf-hidden">
      <div class="error-message"></div>
    </div>
  </div>
  <div class="current-version-container binf-hidden">
    <div class="current-version-label field-label">{{currentVersionLabel}}</div>
    <div class="current-version-details"></div>
  </div>
  <div class="dots-loader binf-hidden">
    <span class="csui-loading-dots-wrapper">
      <span class="csui-loading-dot"></span>
      <span class="csui-loading-dot"></span>
      <span class="csui-loading-dot"></span>
    </span>
  </div>
  <div class="addon-installer-container binf-hidden">
    <div class="addon-installer-icon"></div>
    <div class="addon-installer-label">{{addonInstallerLabel}}</div>
    <div class="addon-installer-button download-button" role="button" aria-label="{{downloadAria}}"
         title="{{downloadTitle}}" tabindex="0">{{downloadLabel}}</div>
  </div>
  <div class="addon-upgrade-installer-container binf-hidden">
    <div class="addon-upgrade-installer-message">
      <div class="addon-upgrade-installer-icon info-icon"></div>
      <div class="addon-upgrade-installer-label">{{addonUpgradeInstallerLabel}}</div>
    </div>
    <div class="addon-upgrade-installer-button download-button" role="button" aria-label="{{downloadAria}}"
         title="{{downloadTitle}}" tabindex="0">{{downloadLabel}}</div>
  </div>
</div>
<div class="location-path-container settings-container binf-hidden">
  <div class="location-path-header user-settings-header">{{locationPathHeader}}</div>
  <div class="location-path-description user-settings-description">{{locationPathDescription}}</div>
  <div class="temporary-path-container path-container">
    <div class="temporary-path-label field-label">{{temporaryPathLabel}}</div>
    <div class="temporary-path-field path-field"></div>
    <div class="error-panel binf-hidden">
      <div class="error-message"></div>
    </div>
  </div>
  <div class="checkout-path-container path-container">
    <div class="checkout-path-label field-label">{{checkoutPathLabel}}</div>
    <div class="checkout-path-field path-field"></div>
    <div class="error-panel binf-hidden">
      <div class="error-message"></div>
    </div>
  </div>
</div>
