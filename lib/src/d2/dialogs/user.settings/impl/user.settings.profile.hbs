<div class="user-profile">
  <div class="user-avatar">
    <div role="button" class="user-avatar-container" tabindex="0" aria-label="{{editAria}}"></div>
    <div class="edit-user-image-placeholder edit-user" title="{{editTitle}}"></div>
    <input type="file" accept="{{supportedFormats}}" class="file-browser binf-hidden"/>
    <div class="dots-loader binf-hidden">
      <span class="csui-loading-dots-wrapper">
        <span class="csui-loading-dot"></span>
        <span class="csui-loading-dot"></span>
        <span class="csui-loading-dot"></span>
      </span>
    </div>
  </div>
  <div class="d2-user-title">{{name}}</div>
</div>
