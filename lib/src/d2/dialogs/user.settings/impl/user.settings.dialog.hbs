<div class="d2-user-settings-header">
  <div class="cs-close" title="{{lang.closeButtonLabel}}" tabindex="0" aria-label="{{lang.closeButtonAriaLabel}}"
       role="button">
    <div class="icon circular d2-icon-close"></div>
  </div>
  <div class="user-profile-container"></div>
</div>
<div class="refresh-container binf-hidden">
  <div class="refresh-label">{{refreshLabel}}</div>
  <div class="refresh-button" role="button" aria-label="{{refreshAria}}"
       title="{{refreshTitle}}" tabindex="0"><span>{{{icon-v2 iconName=iconName theme=iconTheme states='true'}}}</span></div>
</div>
<div class="d2-user-settings-body">
  <div class="ctf-container">
  </div>
  <div class="sort-options-container settings-container">
    <div class="sort-options-header user-settings-header">{{sortOptionsHeader}}</div>
    <div class="enable-file-grouping toggle-switch-container">
      <div class="toggle-switch">
        <div class="enable-file-grouping-label toggle-switch-label">{{enableFileGroupingLabel}}</div>
        <div class="enable-file-grouping-switch"></div>
      </div>
      <div class="error-panel binf-hidden">
        <div class="error-message"></div>
      </div>
    </div>
  </div>
   <div class="last-navigation-container settings-container">
        <div class="last-navigation-header user-settings-header">{{lastNavigatedPathHeader}}</div>
        <div class="enable-last-navigation toggle-switch-container">
          <div class="toggle-switch">
            <div class="last-navigation-label toggle-switch-label">{{enableLastNavigatedPathHeader}}</div>
            <div class="last-navigation-path-switch"></div>
          </div>
          <div class="error-panel binf-hidden">
            <div class="error-message"></div>
          </div>
        </div>
      </div>
  <div class="accessibility-container settings-container">
    <div class="accessibility-header user-settings-header">{{accessibilityHeader}}</div>
    <div class="accessibility-description user-settings-description">{{accessibilityDescription}}</div>
    <div class="accessible-compliant-mode toggle-switch-container">
      <div class="toggle-switch">
        <div class="accessible-compliant-mode-label toggle-switch-label">{{accessibleCompliantModeLabel}}</div>
        <div class="accessible-compliant-mode-switch"></div>
      </div>
      <div class="error-panel binf-hidden">
        <div class="error-message"></div>
      </div>
    </div>
  </div>
  <div class="language-container settings-container">
    <div class="language-header user-settings-header">{{languageHeader}}</div>
    <div class="language-description user-settings-description">{{languageDescription}}</div>
    <div class="default-language-container">
      <div class="default-language-label field-label">{{defaultLanguage}}</div>
      <div class="default-language-field"></div>
      <div class="error-panel binf-hidden">
        <div class="error-message"></div>
      </div>
    </div>
  </div>
  <div class="dateformat-settings-container settings-container">
    <div class="dateformat-header user-settings-header">{{dateFormatHeader}}</div>
    <div class="dateformat-description user-settings-description">{{dateFormatDescription}}</div>
    <div class="dateformat-container">
      <div class="datetimeformat-field-container">
        <div class="datetimeformat-label field-label">{{dateTimeFormat}}</div>
        <div class="datetimeformat-field"></div>
        <div class="error-panel binf-hidden">
          <div class="error-message"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="task-attachments-container settings-container">
    <div class="task-attachments-header user-settings-header">{{quickAccessTaskAttachmentHeader}}</div>
    <div class="task-attachments-description user-settings-description">{{quickAccessTaskAttachmentDescription}}</div>
    <div class="task-attachments toggle-switch-container">
      <div class="toggle-switch">
        <div class="task-attachments-label toggle-switch-label">{{quickAccessTaskAttachmentLabel}}</div>
        <div class="task-attachments-switch"></div>
      </div>
      <div class="error-panel binf-hidden">
        <div class="error-message"></div>
      </div>
    </div>
  </div>
</div>
