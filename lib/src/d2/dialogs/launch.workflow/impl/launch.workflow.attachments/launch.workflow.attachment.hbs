{{#if enableIcon}}<span class="csui-type-icon {{icon}}"></span>{{/if}}

{{#if package}}
<span  data-package-type="{{package.type}}"  data-package-name="{{package.name}}" title="{{package.name}}" class="list-item-title package-info" role="link" aria-label="{{itemLabel}}">
   {{package.name}}  
   {{#if package.is_mandatory}}
    <span  class="mandatory">*</span>
   {{/if}}
</span>
{{/if}}
<span title="{{name}}" class="list-item-title" role="link" aria-label="{{itemLabel}}">{{name}}</span>


<div class="inline-action-bar-container binf-hidden"></div>
<span class="csui-tileview-more-btn binf-hidden"></span>
<div class="inline-toolbar-container binf-hidden"></div>
<hr/>
