<div optionid="{{id}}" title="{{itemTitle}}" class="typeahead-option-item">
  <div class="assignee-avatar"></div>
  <div class="assignee-details">
    <div class="typeahead-text-container assignee-name" value="{{name}}">{{name}}</div>
    <div class="typeahead-text-container assignee-email" value="{{id}}">{{id}}</div>
  </div>
</div>
