{{#if singleItem}}
  <div class="drag-single-assignee drag-chicklet">
    <div class="chicklet-text">{{chickletText}}</div>
  </div>
{{else}}
  <div class="drag-multiple-assignee">
    <div class="front-layer drag-chicklet">
      <div class="chicklet-count">{{chickletCount}}</div>
      <div class="chicklet-text">{{chickletText}}</div>
    </div>
    <div class="back-layer drag-chicklet"></div>
  </div>
{{/if}}
