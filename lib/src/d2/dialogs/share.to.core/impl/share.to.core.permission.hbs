<div class="permission">
  <div class="permission-header focusable" role="button" tabindex="-1">
    <span class="permission-name">{{permissionLabel}}</span>
    <span class="permission-count"></span>
  </div>
  <div class="permission-message"></div>
</div>
<div class="permission-assignee">
  <div class="assignee-select"></div>
  <div class="error-panel">
    <div class="error-message"></div>
    <div class="error-action-wrapper">
      <div class="error-action focusable" role="button" tabindex="-1"></div>
      <div class="error-cancel focusable" role="button" tabindex="-1">{{cancelCaption}}</div>
    </div>
  </div>
</div>


