<div class="d2-vdoc-templates">
  <div class="d2-vdoc-template-header">
    <div class="d2-vdoc-template-header-data">
      <div id="d2-vdoc-template-column-search" class="d2-vdoc-template-column-search"></div>
    </div>
  </div>
  <div class="d2-vdoc-template-body">
    <div class="d2-vdoc-template-container d2-recent-vdoc-templates binf-hidden">
      <div class="template-title">{{recentTitle}}</div>
      <div class="d2-table">
        <div class="csui-table-view"></div>
      </div>
    </div>
    <div class="d2-vdoc-template-container d2-preset-vdoc-templates">
      <div class="template-title binf-hidden">{{presetTitle}}</div>
      <div class="d2-table">
        <div class="csui-table-view"></div>
      </div>
    </div>
  </div>
</div>
