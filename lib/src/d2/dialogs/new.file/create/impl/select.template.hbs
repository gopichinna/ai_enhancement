<div class="d2-templates">
    <div class="d2-template-header"></div>
    <div class="d2-template-body">
        <div class="collapsible-group-story">
            <otc-collapsible-group class="otc-collapsible-group recent-collapsible-group" listarialabel="{{recentTitleListAriaLabel}}" arialabel="{{recentTitleAriaLabel}}" togglearialabel="{{recentTitleToggleAriaLabel}}" tabindex="0">
                <span slot="header" class="template-title">{{recentTitle}}</span>

                <div class="collapsible-group-user-item" role="listitem">
                    <div class="d2-template-container d2-recent-templates">
                        <div class="d2-table">
                            <div class="csui-table-view"></div>
                        </div>
                        <div class="d2-template-table cs-thumbnail-wrapper">
                            <div class="csui-table-view"></div>
                        </div>
                    </div>
                </div>

            </otc-collapsible-group>

            <otc-collapsible-group class="otc-collapsible-group preset-collapsible-group" listarialabel="{{presetTitleListAriaLabel}}" arialabel="{{presetTitleAriaLabel}}" togglearialabel="{{presetTitleToggleAriaLabel}}" tabindex="0">
                <span slot="header" class="template-title">{{presetTitle}}</span>

                <div class="collapsible-group-user-item" role="listitem">
                    <div class="d2-template-container d2-preset-templates">
                        <div class="d2-table">
                            <div class="csui-table-view"></div>
                        </div>
                        <div class="d2-template-table cs-thumbnail-wrapper">
                            <div class="csui-table-view"></div>
                        </div>
                    </div>
                </div>

            </otc-collapsible-group>
        </div>
    </div>
</div>

