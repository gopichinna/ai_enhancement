<div class="o2-processing-view-container">
  <div class="processing-icon"></div>
  <div class="processing-label">{{labelProcessing}}</div>
  <div class="progressbar-container d2-progresspanel">
    <div class="binf-progress">
      <div class="binf-progress-bar o2-progress-bar" role="progressbar" aria-valuenow="{{percentage}}"
           aria-valuemin="0" aria-valuemax="100" style="width:{{percentage}}%">
      </div>
    </div>
  </div>
</div>


