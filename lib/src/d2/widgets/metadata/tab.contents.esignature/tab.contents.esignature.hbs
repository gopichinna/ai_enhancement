<div class="d2-tab-contents-esignature-content">
  {{#if showExpand}}<div class="d2-tab-contents-esignature-expand expand" tabindex="0"></div>{{/if}}
  <div class="binf-col-md-12 esignature-container-label {{#if setEsignRequired}}required{{/if}}" title="Electronic signature">
    <h4> {{eSignLabel}}</h4>
  </div>
  <div class="d2-tab-contents-esignature-content-form"></div>
  <div class="d2-tab-contents-esignature-message-wrapper">
    <span class="esignature-message">{{eSignMessage}}</span>
  </div>
</div>
