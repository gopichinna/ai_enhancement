<otc-collapsible-group class='d2-bws-members-list' showToggleMode="auto" {{#if expanded}}expanded{{/if}}>
    <div slot='header' class='d2-bws-members-card-header'>
        <div class='d2-bws-role-name' title='{{group_display_name}}' tabindex='{{tabIndex}}'>{{group_display_name}}</div>
        <otc-button class="d2-bws-add-member binf-hidden" title="{{addLabel}}" icon="action:action_add32" tabindex="-1"></otc-button>
    </div>
</otc-collapsible-group>
