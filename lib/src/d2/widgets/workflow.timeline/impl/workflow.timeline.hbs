<div class="timeline-filter"></div>
<div class="timeline-graph d2-wf-state-{{wfState}}">
  <div class="timeline-begin terminal-step">
      <div class="terminal-label" title="{{startActivityLabel}}"></div>
    <div class="terminal-marker"></div>
  </div>
  <div class="timeline-nodes"></div>
  <div class="timeline-end terminal-step">
    <div class="terminal-marker"></div>
    <div class="terminal-label" title="End"></div>
  </div>
</div>
<div class="timeline-error-container"></div>
