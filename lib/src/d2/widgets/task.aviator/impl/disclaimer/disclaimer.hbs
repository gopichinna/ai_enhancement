<div class="aie-chat-disclaimer-body">
  <h2>{{lang.disclaimerHead}}</h2>
  <p>{{lang.disclaimerText}}</p>
  <otc-checkbox>{{lang.disclaimerNotAgain}}</otc-checkbox>
</div>
<div class="aie-chat-disclaimer-footer">
  <otc-button class="aie-accept" type="primary"
    arialabel="{{lang.disclaimerAcceptLabel}}">{{lang.disclaimerAcceptTitle}}</otc-button>
  <otc-button class="aie-reject" type="secondary"
    arialabel="{{lang.disclaimerRejectLabel}}">{{lang.disclaimerRejectTitle}}</otc-button>
</div>

