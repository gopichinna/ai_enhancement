<a class="binf-list-group-item {{#unless model.parent}}has-next{{/unless}}{{#xif
    "this.model.selected === true"}} selected{{/xif}}{{#xif "!this.typeSelected && this.model.parentLabel"}} has-parent{{/xif}}"
    data-d2-name="{{model.name}}" data-d2-parent="{{model.parent}}">
  {{#xif "!this.typeSelected && this.model.parentLabel"}}<small>{{model.parentLabel}}</small>{{/xif}}<div>{{model.label}}</div></a>
