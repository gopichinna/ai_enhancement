<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <div class="link-container">
      {{#each items}}
        <a {{#if id}}data-id="{{id}}"{{/if}} tabindex="0" data-cstabindex="0" class="v-link" aria-label="{{versionLabel}}">
          <span class="placeholder" title="{{versionLabel}}" data-cstabindex="0">{{versionLabel}}</span>
        </a>
      {{/each}}
    </div>
  </div>
</div>

