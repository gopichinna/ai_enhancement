<div class="csui-alternating-toolbars">
  <div class="csui-table-tabletoolbar"></div>
  <div class="csui-table-rowselection-toolbar"></div>
</div>
<div class="csui-facet-table-container">
  <div class="csui-table-facetview csui-facetview-hidden csui-facetview-visibility"></div>
  <div class="d2-table-queryformview d2-query-form-view d2-popover-panel d2-queryformview-hidden d2-queryformview-visibility"></div>
  <div class="d2-collections-wrapper"></div>
  

  <div class="csui-outertablecontainer">
    <div class="d2-widgettable csui-innertablecontainer">
      <div class="csui-table-facetbarview"></div>
      <div class="d2-table-view"></div>
      <div class="cs-thumbnail-wrapper"></div>
      <div class="d2-pagination-view"></div>
    </div>
  </div>
</div>

<div class="collections-empty-view">
  <div class="collections-empty-view-content">
    <div class="empty-collection-icon"></div>
    <div class="start-org-message">{{lang.startOrgMessage}}</div>
    <div class="create-col-message">{{lang.createColMessage}}</div>
    <div class="create-btn">
      <otc-button
        class="d2-otc-btn form-btn search create-collection-btn"
        type="primary"
        button-id="search"
        ariaLabel="d2-otc-btn"
        title="{{lang.createCollectionLabel}}"
        tabindex="0"
      >{{lang.createCollectionLabel}}</otc-button>
    </div>
  </div>
</div>
