<div class="d2-relation-name-container">
  <span title="{{relationName}}" class="list-item-relation" role="link" aria-label="{{itemLabel}}">{{relationName}}</span>
</div>
<div class="d2-relation-details-container">
  {{#if enableIcon}}<span class="csui-type-icon {{icon}}"></span>{{/if}}
  <span class="list-item-title-container" ><span  title="{{name}}" class="list-item-title"  role="link" aria-label="{{itemLabel}}">{{name}}</span></span>
</div>
