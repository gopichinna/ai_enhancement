<div class="note-author-container">
  <span class="note-author-profile-container"></span>
  <div class="note-author-name-email">
    <span class="note-author">{{noteAuthor}}</span>
    {{#if isTouchBrowser}}
      <span class="note-author-email"></span>
    {{/if}}
  </div>
</div>

<div class="note-date-container">
  <span class="note-date" title="{{noteDateTitle}}">{{noteDate}}</span>
  {{#if isTouchBrowser}}
    <span class="note-time" title="{{noteDateTitle}}">{{noteTime}}</span>
  {{/if}}
</div>
