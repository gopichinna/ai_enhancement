{{#if enabled}}
  <div class='csui-favorite-star-view-container csui-favorite-popover-container'>
    {{#if selected}}
      <a href="#" class="csui-favorite-star selected selected-star" title="{{removeFav}}">{{{icon-v2 iconName=iconName theme=iconTheme states='true'}}}</a>
    {{else}}
      <a href="#" class="csui-favorite-star unselected-star" title="{{addFav}}">{{{icon-v2 iconName=iconName theme=iconTheme states='true'}}}</a>
    {{/if}}
  </div>
{{/if}}

