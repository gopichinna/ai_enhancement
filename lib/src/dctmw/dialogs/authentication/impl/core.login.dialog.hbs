<div class="binf-modal-dialog binf-modal-lg">
  <div class="tile-header binf-modal-header csui-acc-tab-region">
    <span class="tile-type-icon title-icon dctm-icon-core-login"></span>
    <div class="tile-title">
      <h4 class="tile-title binf-modal-title">{{title}}</h4>
    </div>
    <div class="cs-header-control"></div>
    <div class="cs-close">
      <div class="icon circular cs-icon-cross csui-acc-focusable-active" tabindex="0" role="button"
          title="{{closeTooltip}}" aria-label="{{closeTooltip}}"></div>
    </div>
  </div>
  <div class="binf-modal-body">
    <iframe frameborder="0" title="{{title}}" src="{{coreAuthUrl}}"></iframe>
  </div>
</div>
