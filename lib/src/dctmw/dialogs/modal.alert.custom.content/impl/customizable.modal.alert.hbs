<div role="alertdialog"
  {{#if dialogSize}}
     class="binf-modal-dialog binf-modal-{{dialogSize}}"
  {{else}}
     class="binf-modal-dialog"
  {{/if}}

  {{#if showHeader}}
     aria-labelledby="{{dlgTitleId}}"
  {{/if}}
  {{#if message}}
     aria-describedby="{{dlgMsgId}}"
  {{/if}}
>
  <div class="binf-modal-content">
    {{#if showHeader}}
        <div class="binf-modal-header {{headerClass}}">
            {{#if showTitleCloseButton}}
                <button type="button" class="binf-close" data-binf-dismiss="modal"
                        aria-label="{{closeButtonAria}}" title="{{closeButtonTooltip}}" tabindex="0">
                    <span class="icon {{titleCloseIcon}}"></span>
                </button>
            {{/if}}
            <h4 class="binf-modal-title">
                {{#if showTitleIcon}}
                {{#if isJATO}}
                    <span class="smart-notification-icon">{{{jatoTitleIcon}}}</span>
                {{else}}
                   <otc-icon class="smart-notification-icon" icon="smart_notification:{{titleIcon}}" isPresentation></otc-icon>
                {{/if}}
                {{/if}}
                <span class="title-text" id="{{dlgTitleId}}">{{title}}</span>
            </h4>
        </div>
    {{/if}}

    <div class="binf-modal-body">
      {{#if hasCustomContent}}
      <div class="custom-content-container"></div>
      {{/if}}
      {{#if message}}
        <div class="body-message" id="{{dlgMsgId}}" title="{{message}}">{{message}}</div>
      {{/if}}
    </div>


    {{#if message}}
    <div class="binf-modal-footer">
    {{else}}
    <div class="binf-modal-footer csui-no-body">
    {{/if}}
    {{#if isMobile}}
      {{#if buttons.showYes}}
        <button type="button" class="binf-btn binf-btn-primary csui-yes csui-default" tabindex="0"
                data-binf-dismiss="modal" title="{{buttons.labelYes}}">{{buttons.labelYes}}</button>
      {{/if}}
      {{#if buttons.showNo}}
        <button type="button" class="binf-btn binf-btn-default csui-no" tabindex="0"
                data-binf-dismiss="modal" title="{{buttons.labelNo}}">{{buttons.labelNo}}</button>
      {{/if}}
      {{#if buttons.showCancel}}
        <button class="binf-btn binf-btn-default csui-cancel" tabindex="0"
                data-binf-dismiss="modal" title="{{buttons.labelCancel}}">{{buttons.labelCancel}}</button>
      {{/if}}
    {{/if}}
  </div>
  </div>
  </div>
</div>
