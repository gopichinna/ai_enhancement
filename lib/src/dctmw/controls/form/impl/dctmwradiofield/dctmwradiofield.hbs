{{#if writeonlyMode}}
<div class="cs-field-write" role="radiogroup" aria-labelledby="{{idBtnLabel}}">
  <div class="cs-field-write-inner">
    {{#if isJATO}}
      <otc-radiogroup columns="{{columns}}">
        {{#each items}}
          <otc-radio value="{{id}}" id="{{id}}" readonly="false" name="{{../radioGroupName}}" {{#if isChecked}}checked=""{{/if}}>{{name}}</otc-radio>
        {{/each}}
      </otc-radiogroup>
    {{else}}
      <ul style="{{alignmentStyle}}">
        {{#each items}}
        <li class="{{../horizontalStyle}}">
          <div class="dctmw-radio-item-container">
            <label class="{{class}}" for="{{id}}">{{name}}
              <input type="radio" class="radio-item" name="{{../radioGroupName}}" value="{{id}}" id="{{id}}"
                {{{checked}}} />
              <span class="dctmw-radio-container"><span class="outer"><span class="inner"></span></span></span>
            </label>
          </div>
          <span class="dctmw-text-overflow dctmw-more-text"></span>
        </li>
        {{/each}}
      </ul>
      <span class="validation-error-message {{#if
            validationErrorMsg}}{{else}}binf-hidden{{/if}}">{{validationErrorMsg}}</span>
    {{/if}}
  </div>
</div>
{{/if}}

<div class="cs-field-read">
  <div class="cs-field-read-inner">
    {{#if isJATO}}
      <otc-radiogroup columns="{{columns}}">
        {{#each items}}
          <otc-radio id="{{id}}" name="read_{{../radioGroupName}}" readonly="" {{#if isChecked}}checked=""{{/if}}>{{name}}</otc-radio>
        {{/each}}
      </otc-radiogroup>
    {{else}}
      <div class="btn-container">
        <button {{#if this.hasData}} title="{{name}}" {{else}} title="{{noValue}}" {{/if}} {{#if
          schema.readonly}}tabindex="-1" data-cstabindex="-1" {{/if}}>
          {{#if this.hasData}}
          <span class="selected-label">{{name}}</span>
          {{else}}
          <span class="selected-label placeholder">
            {{emptyLabel}}</span>
          {{/if}}
        </button>
      </div>
    {{/if}}
  </div>
</div>
