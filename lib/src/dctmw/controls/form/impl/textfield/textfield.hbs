{{#xif "this.mode === 'writeonly'"}}
<div class="cs-field-write">
  <div class="cs-field-write-inner" {{#if schema.disabled}}
       title="{{#if data}} {{data}} {{else}} {{noValue}} {{/if}}" {{/if}}>
    <input type="{{inputType}}" id="{{id}}" {{#if options.placeholder}}placeholder="{{options.placeholder}}" {{/if}}
      {{#if options.size}}size="{{options.size}}" {{/if}} {{#if
      options.nameIdentifier}}name="{{options.nameIdentifier}}" {{/if}} {{#each options.data}}data-{{@key}}="{{this}}"
      {{/each}} {{#each options.attributes}}{{@key}}="{{this}}" {{/each}} value="{{data}}" {{#if
      idBtnLabel}}aria-labelledby="{{idBtnLabel}}" {{/if}} {{#if multiFieldLabel}} aria-label="{{multiFieldLabel}}"
      {{/if}} {{#if ariaRequired}} aria-required="{{ariaRequired}}" {{/if}} autocomplete="off" />
  </div>
</div>
{{/xif}}
<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <div class="btn-container">
      {{#xif "this.options && this.options.type === 'dctmwurl'"}}
      <a href="{{absUrl}}" target="_blank"
        title="{{#if options.anchorTitle}}{{options.anchorTitle}}{{else}}{{data}}{{/if}}" {{#if multiFieldLabel}}
        aria-label="{{readModeMultiFieldAria}}" {{else}} aria-label="{{readModeAria}}" {{/if}}>
        {{#if this.hasData}}
        <span>{{data}}</span>
        {{else}}
        <span class="placeholder" title="{{noValue}}">{{emptyLabel}}</span>
        {{/if}}
      </a>
      {{else}}
      <button title="{{tooltip}}" {{#if schema.readonly}} aria-disabled="true" {{/if}} {{#if multiFieldLabel}}
        aria-label="{{readModeMultiFieldAria}}" {{else}} aria-label="{{readModeAria}}" {{/if}}>
        {{#if this.hasData}}
        {{#if repeatingLabelData}}
        <span class="dctmw-repeating-label">{{repeatingLabelData}}</span>
        {{else}}
        <span>{{data}}</span>
        {{/if}}
        {{else}}
        <span class="placeholder" title="{{noValue}}">{{emptyLabel}}</span>
        {{/if}}
      </button>
      {{/xif}}
    </div>
  </div>
</div>
