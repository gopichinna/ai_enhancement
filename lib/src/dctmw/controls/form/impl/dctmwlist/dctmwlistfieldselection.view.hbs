<ul
  class="{{#if showHorizontal}}dctmw-listfield-chicklets{{/if}} dctmw-listfield-selectedvalues {{#if isSortable}}dctmw-listfield-sortable{{/if}}">
  {{#if readOnly}}
  {{#if noData}}
  <li>
    <div class="btn-container">
      <button aria-disabled="true" title="{{noValue}}">
        <span class="placeholder" title="{{emptyLabel}}">{{emptyLabel}}</span>
      </button>
    </div>
  </li>
  {{/if}}
  {{/if}}
</ul>
<div class="dctmw-list-toolbar">
  <a href="#" class="dctmw-list-toolbar-action" data-dctmw-list-toolbar-action="showMore">{{showMoreLabel}}</a>
  <a href="#" class="dctmw-list-toolbar-action" data-dctmw-list-toolbar-action="showLess">{{showLessLabel}}</a>
</div>
