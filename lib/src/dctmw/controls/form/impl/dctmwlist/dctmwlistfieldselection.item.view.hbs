{{#if showButtonInReadMode}}
  <button aria-disabled="true" title="{{name}}">
    <span title="{{name}}">{{name}}</span>
  </button>
{{else}}
  <a tabindex="-1" title="{{name}}">
  {{#if isNotShowHorizontal}}
    {{#if isJato}}
      <otc-icon svg="{{actionDragSVG}}" class="dctmw-listfield-icon-container {{#if isSortable}}dctmw-icon-drag{{/if}}" ></otc-icon>
    {{else}}
       <span class="dctmw-listfield-icon-container {{#if isSortable}}dctmw-icon-drag{{/if}}"></span>
    {{/if}}
  {{/if}}
  {{#if showOptionsInHierarchy}}
      <span class="dctmw-listfield-selectedlabel">{{hierarchyItemLabel}}</span>
  {{else}}
      <span class="dctmw-listfield-selectedlabel">{{name}}</span>
  {{/if}}
  {{#if isNotReadMode}}
      {{#if isJato}}
            <otc-icon svg="{{removeSVG}}" class="dctmw-listfield-icon-container dctmw-remove-selectedValue dctmw-icon-selected-close" ></otc-icon>
      {{else}}
            <span class="dctmw-listfield-icon-container dctmw-remove-selectedValue dctmw-icon-selected-close"></span>
      {{/if}}
  {{/if}}
  </a>
{{/if}}

