<a class="list-options-item dctmw-list-option-item-wrapper" tabindex="-1" title="{{name}}">
    <otc-checkbox class="dctmw-list-option-item" {{#if selected}}checked=""{{/if}} {{#if
            options.disabled}}readonly=""{{/if}} name="{{name}}" arialabel="{{name}}">
        <span class="dctmw-list-option-item-name">{{name}}</span>
    </otc-checkbox>
</a>
