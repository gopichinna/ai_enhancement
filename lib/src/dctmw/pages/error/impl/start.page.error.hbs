<div>
{{#if showHeader}}
    <div class="csui-global-message"></div>
    <nav class="d2-navbar start-page-error-navbar">
      <div class="binf-container-fluid" role="menubar">
        <div class="binf-navbar-nav">
          <div class="d2-branding">
            <div class="d2-brand-container">
              <span class="d2-brand-logo"></span>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>
{{/if}}
<div class="main-area">
  <div class="server-error-img-container"><span class="server-error-img"></span></div>
  <div class="error-message-wrapper">
    {{#each errorMsgs}}
      <h3>{{this}}</h3>
    {{/each}}
  </div>

  <div class="buttons-container">
    {{#if showReload}}
      <div class="button-container">
        <span class="page-reload img-button page-reload-img" title="{{reloadLabel}}" aria-label="{{reloadLabel}}" tabindex="0"></span>
        <div>
          <span class="page-reload img-button-text" title="{{reloadLabel}}" tabindex="0">{{reloadLabel}}</span>
        </div>
      </div>
    {{/if}}

    {{#if showSignout}}
      <div class="button-container">
        <span class="signout-user img-button signout-img" title="{{signOut}}" aria-label="{{signOut}}" tabindex="0"></span>
        <div>
          <span class="signout-user img-button-text" title="{{signOut}}" tabindex="0">{{signOut}}</span>
        </div>
      </div>
    {{/if}}
  </div>
</div>
