<div class="tile-header">
  <div class="tile-title">
    <h2 class="csui-heading" title="{{widgetTitle}}">{{widgetTitle}}</h2>
  </div>
</div>
<div>
  <div title="{{widgetMessage}}" class="csui-pman-widget-msg">
  {{#if isJATO}}
    <otc-icon class="csui-pman-widget-jato-icon" type="raw" svg="{{configureWidgetPaceholderSVG}}" ispresentation></otc-icon>
  {{else}}
    <div class="csui-pman-widget-icon"></div>
  {{/if}}
    <div>{{widgetMessage}}</div>
  </div>
</div>
