<div class="icon-them-container" data-smart-theme="{{themeCode.DEFAULT}}" aria-label="{{defaultLabel}}">
    <div class="icon-label-container">
        <div class="icon_theme_input">
            <input type="radio" name="theme" title="{{defaultLabel}}" value="" tabindex="0" id="default" />
        </div>
        <label for="default">{{defaultLabel}}</label>
    </div>
    <div class="icon_theme_preview"></div>
</div>
<div class="icon-them-container" data-smart-theme="{{themeCode.DARK}}" aria-label="{{darkLabel}}">
    <div class="icon-label-container">
        <div class="icon_theme_input">
            <input type="radio" name="theme" title="{{darkLabel}}" value="{{themeCode.DARK}}" tabindex="0" id="dark" />
        </div>
        <label for="dark">{{lightLabel}}</label>
    </div>
    <div class="icon_theme_preview"></div>
</div>
<div class="icon-them-container" data-smart-theme="{{themeCode.LIGHT}}" aria-label="{{lightLabel}}">
    <div class="icon-label-container">
        <div class="icon_theme_input">
            <input type="radio" name="theme" title="{{lightLabel}}" value="{{themeCode.LIGHT}}" id="light"
                tabindex="0" />
        </div>
        <label for="light">{{darkLabel}}</label>
    </div>
    <div class="icon_theme_preview"></div>
</div>
