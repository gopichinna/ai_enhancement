<div class="pman-setting-header csui-accordion-header" aria-label="{{expandTab}} {{settingTitle}}" role="tab" tabindex="0">
    <div class="csui-accordion-header-title" aria-hidden="true">{{settingTitle}}</div>
    <span class="csui-button-icon cs-icon icon-expandArrowDown" title="{{expandTab}} {{settingTitle}}"></span>
    <span class="csui-button-icon cs-icon icon-expandArrowUp" title="{{collapseTab}} {{settingTitle}}"></span>
</div>
<div class="pman-setting-content csui-accordion-content perspective-widget-form csui-pman-form-wrapper binf-hidden"></div>
