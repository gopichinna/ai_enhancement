{{#if isJato}}
    <otc-button class="csui-acc-focusable csui-sidebar-item {{iconClass}}" size="regular" type="subtle" title="{{tooltip}}">
        <otc-icon svg="{{iconSVG}}" ispresentation></otc-icon>
    </otc-button>
{{else}}
    <otc-button type="button" class="csui-acc-focusable csui-sidebar-item {{iconClass}}" title="{{tooltip}}" icon="{{iconName}}"> 
    </otc-button>
{{/if}}
