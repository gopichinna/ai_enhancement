<div class="pman-backdrop"></div>
<div class="pman-header">
  <div class="pman-header-backdrop"></div>
  <div class="pman-tools-container">
    <div class="pman-left-tools">
      <ul>
        <li class="pman-toolitem icon-help-container">
                <otc-button class="icon-help"  type="subtle" title="{{this.help}}" arialabel="{{this.help}}" {{#if isJATO}} size="regular" {{else}}  icon="csui_action:action_help32"  {{/if}}>
                  {{#if isJATO}}<otc-icon mirrorIfRtl size="20" svg="{{helpIcon}}" ispresentation></otc-icon>{{/if}}
                </otc-button>        
        </li>
        <li class="pman-toolitem toolbarAddContainer">
          <button class="icon icon-toolbarAdd" title="{{this.addWidget}}"></button>
        </li>
      </ul>
      <div class="pman-pannel-wrapper"></div>
    </div>
      <div class="pman-center-tools">
       
      <ul class="pman-tabs-container">
        {{#if isHomePage}}
        <li>
          <a class="pman-tab" title="{{this.pageContent}}" aria-label="{{this.pageContentAriaLabel}}" role="button" tabindex="0">{{this.pageContent}}</a>
        </li>
        <li>
          <a class="pman-tab pman-header-tab" title="{{this.header}}" aria-label="{{this.headerAriaLabel}}" role="button" tabindex="0">{{this.header}}</a>
        </li>
        {{/if}}
      </ul>
    </div>
    <div class="pman-right-tools">
      <ul>
        {{#if personalizeMode}}
          <li>
            <otc-button type="secondary" class="pman-icon-reset" title="{{this.reset}}"
                    arialabel="{{this.resetAriaLabel}}">{{this.reset}}</otc-button>
          </li>
        {{/if}}
        <li>
          <otc-button class="pman-right-tools-button pman-icon-save" disabled type="primary" title="{{this.save}}" arialabel="{{this.saveAriaLabel}}">{{this.save}}</otc-button>
        </li>
        <li>
          <otc-button class="pman-right-tools-button pman-cancel-edit" type="secondary" title="{{this.cancel}}" arialabel="{{this.cancelAriaLabel}}">{{this.cancel}}</otc-button>
          </li>
      </ul>
    </div>
  </div>
  <div class="pman-trash-area">
    <div class="pman-trash-banner"></div>
  </div>
</div>
<div id="breadcrumb-wrap" class="pman-header-config breadcrumb-wrap-visible">
  <div class="pman-header-preview-panel">
    <div class="pman-header-container pman-container-header-container">
      <div class="pman-container-header"></div>
      <div class="breadcrumb-inner breadcrumb-inner-header pman-container-breadcrumb csui-perspective-breadcrumb">
      </div>
    </div>
  </div>
  <div class="pman-header-settings-container">
  </div>
</div>
<div class="pman-backdrop"></div>
