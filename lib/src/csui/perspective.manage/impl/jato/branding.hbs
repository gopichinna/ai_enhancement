<div class="pman-backdrop"></div>
<div class="pman-header">
  <div class="pman-header-backdrop"></div>
  <div class="pman-tools-container">
    <div class="pman-left-tools">
      <otc-button class="icon-help" title="{{this.help}}">
        <otc-icon type='raw' svg='{{this.helpIcon}}'></otc-icon>
      </otc-button>
    </div>
    <div class="pman-right-tools">
      <otc-button type="primary" arialabel="{{this.saveAriaLabel}}" title="{{this.save}}" disabled class="pman-icon-save">
          {{this.save}}
      </otc-button>
      <otc-button type="secondary" arialabel="{{this.cancelAriaLabel}}" title="{{this.cancel}}"  class="pman-cancel-edit">
          {{this.cancel}}
      </otc-button>
    </div>
  </div>
</div>
<div id="breadcrumb-wrap" class="pman-header-config breadcrumb-wrap-visible">
  <div class="pman-header-preview-panel">
    <div class="pman-header-container pman-container-header-container">
      <div class="pman-header-preview">
        <span>{{lightModeBranding}}</span>
        <div data-smart-theme='light' branding-theme='light' class="pman-jato-header-container pman-light-header-container"></div>
      </div>
      <div class="pman-header-preview">
        <span>{{darkModeBranding}}</span>
        <div data-smart-theme='dark' branding-theme='dark' class="pman-jato-header-container pman-dark-header-container"></div>
      </div>
    </div>
  </div>
  <div class="pman-header-settings-edit-branding">
      <div class="csui-header-settings-list-title" >{{headerSettings}}</div>
      <div class="csui-header-settings-list-lg"></div>
      <div class="pman-header-jato-settings-container">
    </div>
  </div>
</div>
<div class="pman-backdrop"></div>
