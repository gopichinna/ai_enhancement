<div class="binf-row">
  {{#each fields}}
    {{#if this.isSetType}}
      <div class="binf-col-md-12 cs-form-singlecolumn cs-form-set"
           id="csfSingleCol_{{../modelId}}{{@index}}"></div>
    {{else}}
      <div class="binf-col-md-12 cs-form-doublecolumn"
           id="csfLeftCol_{{../modelId}}{{@index}}"></div>
    {{/if}}
  {{/each}}
</div>

