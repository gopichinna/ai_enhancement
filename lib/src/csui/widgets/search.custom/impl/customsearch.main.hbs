<div class="csui-saved-search-form {{scrolling}}" id="{{searchFormId}}"></div>

{{#unless hideSearchButton}}
  <div class="csui-saved-search-submit-container">
    <otc-button class="csui-custom-search-form-submit" title="{{messages.search}}" id="{{searchButton}}"
      type="primary">{{messages.search}}
    </otc-button>
    {{#if showResetButton}}
      <otc-button class="csui-custom-reset-form-submit" title="{{messages.reset}}" id="{{resetButton}}"
        type="secondary">{{messages.reset}}
      </otc-button>
    {{/if}}
  </div>
{{/unless}}
