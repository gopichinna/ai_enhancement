<ul class="csui-permission-levels" role="listbox">
  {{#each permissionLevelOptions}}
    <li class="csui-permission-level-item" data-optionid="{{this.id}}" role="option" aria-label="{{this.name}}">
      <a tabindex="-1" href="#">
        <span class="cs-icon">
        {{#if ../isJATO}}
          <otc-icon class="csui-permission-dialog-checkmark" size="16" svg="{{../jatoCheckMarkSelect}}" ispresentation disableeffects></otc-icon>
        {{else}}
          <otc-icon icon="csui_action:action_confirm32" size="18" ispresentation disableeffects></otc-icon>
        {{/if}}
        </span>
        <span class="cs-label">{{this.name}}</span>
        {{#if this.showActionIcon}}          
          <span class="csui-icon {{this.actionIcon}}"></span>
        {{/if}}
      </a>
    </li>
  {{/each}}
</ul>

