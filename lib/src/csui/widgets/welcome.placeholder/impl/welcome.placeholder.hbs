
<div class="csui-hero-tile">
  <div class="csui-hero-left">
    <div role="heading" aria-level="2" class="csui-greeting">{{greeting}}</div>
    <span class="csui-date">{{date}}</span>
  </div>
    <div class="csui-hero-right">
    {{#if includeVideo}}
    <button class="csui-videoButton" aria-label="{{videoLabel}}"></button>
    {{/if}}
    {{#if includeMessage}}
    <div class="csui-message">
      <p title="{{message}}">{{message}}</p>
    </div>
    {{/if}}
  </div>

</div>
