{{#if enabled}}
  <div class='csui-favorite-star-view-container csui-favorite-popover-container'>
      <otc-button id="{{id}}" class="csui-favorite-star csui-acc-focusable {{#if selected}}csui-favorite-selected{{/if}}" iconAppearance="{{iconAppearance}}"
        title="{{title}}" arialabel="{{ariaLabel}}" {{#if isJATO}} size="small" {{else}} icon="{{iconName}}"{{/if}}>
          {{#if isJATO}} <otc-icon svg="{{iconSVG}}"></otc-icon> {{/if}}
      </otc-button>
  </div>
{{/if}}

