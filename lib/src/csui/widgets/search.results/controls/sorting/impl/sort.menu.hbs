{{#if sortEnable}}
  <div class="csui-search-sort-options">
    {{#if isJatoTheme}}
      <otc-button
        id="{{id}}"
        class="cs-dropdown-button open-sort-menu"
        type="subtleDropdown"
        title="{{titleVal}}"
        size="small"
        arialabel="{{sortButtonAria}}"
      >
        {{selectedTitle}}
      </otc-button>
    {{else}}
      <button
        id="{{id}}"
        type="button"
        class="binf-btn binf-btn-default open-sort-menu"
        aria-haspopup="true"
        aria-expanded="false"
        title="{{titleVal}}"
        tabindex="0"
        aria-label="{{sortButtonAria}}"
        >
        <span class="cs-label">{{selectedTitle}}</span>
        <span class="cs-icon icon-caret-down"></span>
      </button>
    {{/if}}
    <otc-menu
      class="csui-table-settings-dropdown"
      buttonId="{{id}}"
      ariarole="menu"
      arialabel="{{listAria}}"
      maxitems="0"
      scrollable="">
    </otc-menu>
  </div>
  {{#if isJatoTheme}}
    {{#if displaySortArrow}}
      <a href="#" role="button" class="search-sort-btn" title="{{titleArrow}}" tabindex="0">
        <otc-icon svg="{{jatoOrderIcon}}" size="18" type="subtle"></otc-icon>
      </a>
    {{/if}}
  {{else}}
    {{#if displaySortArrow}}
      <a href="#" role="button" class="cs-icon search-sort-btn {{orderIcon}}" title="{{titleArrow}}" tabindex="0"></a>
    {{/if}}
  {{/if}}
{{/if}}

