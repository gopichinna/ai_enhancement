<div class="csui-search-expandall-wrapper">
  <div class="csui-search-expandall-text" title="{{messages.expandAll}}">{{messages.expandAll}}</div>
  <otc-button class="csui-search-header-expand-all csui-acc-focusable"
      type="subtle"
      title="{{messages.expandAll}}"
      arialabel="{{messages.expandAll}}"
      {{#if isJATO}} 
        size="small" 
      {{else}}
        iconOnly 
        icon="{{iconName}}"
      {{/if}}>
          {{#if isJATO}}
          <otc-icon type="subtle" svg="{{iconSVG}}" class="expand-jato-icon"></otc-icon>
          {{/if}}
      </otc-button>
</div>
