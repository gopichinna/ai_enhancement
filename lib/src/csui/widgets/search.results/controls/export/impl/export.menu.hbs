<div class="csui-search-export-options">
    {{#if isJatoTheme}}
        <otc-button
                id="export-btn"
                class="cs-dropdown-button"
                type="subtleDropdown"
                title="{{title}}"
        >
            <span class="cs-label">{{title}}</span>
        </otc-button>
    {{else}}
        <button id="export-btn" type="button" class="binf-btn binf-btn-default binf-dropdown-toggle"
                data-binf-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="{{exportButtonAria}}" tabindex="0">
            <span class="cs-label">{{title}}</span>
            <span class="cs-icon icon-caret-down"></span>
        </button>
    {{/if}}
    <otc-menu
            buttonId="export-btn"
            arialabel="{{listAria}}"
            ariarole="menu"
            scrollable="">

    </otc-menu>
</div>
