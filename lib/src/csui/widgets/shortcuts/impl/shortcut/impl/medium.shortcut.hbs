<div class="csui-details smart-tile-group">
    <div class="tile-icon">
    {{#if isJATOTheme}}
        <div class="csui-shortcut-jato-icon"></div>
    {{else}}
        <div class="icon {{icon}}" title="{{name}}" aria-hidden="true"></div>
    {{/if}}
    </div>

    <div class="tile-title">
        <span class="csui-heading binf-line-clamp">{{name}}</span>
    </div>
</div>

