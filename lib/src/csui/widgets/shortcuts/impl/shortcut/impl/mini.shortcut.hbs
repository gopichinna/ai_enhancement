<div class="csui-details smart-tile-group">
    <div class="csui-leftside">
        <div class="tile-icon">
            <div class="icon {{icon}}" title="{{name}}" aria-hidden="true"></div>
        </div>
    </div>

    <div class="csui-rightside">
        <div class="tile-title">
            <h2 class="csui-heading binf-line-clamp">{{name}}</h2>
        </div>
    </div>
</div>


