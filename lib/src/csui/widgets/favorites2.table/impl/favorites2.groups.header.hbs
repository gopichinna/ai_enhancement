{{#if isJATO}}
  <div class="csui-favorites-add-group-btn-wrapper">
    <otc-button class="csui-groups-header-plus" size="small" type="subtle" arialabel="{{groupAddButtonTitle}}" title="{{groupAddButtonTitle}}">
      <otc-icon size="16" svg="{{jatoAddIcon}}"></otc-icon>
    </otc-button>
  </div>
{{else}}
  <button title="{{groupAddButtonTitle}}" aria-label="{{groupAddButtonTitle}}" class="binf-btn csui-groups-header-plus">
    <span class="icon icon-toolbarAdd"></span>
  </button>
{{/if}}
<span class="csui-groups-header-text">{{text}}</span>
<button
    class="binf-btn csui-groups-header-edit-mode csui-groups-header-edit-on">{{startEditMode}}</button>
<button
    class="binf-btn csui-groups-header-edit-mode csui-groups-header-edit-off">{{endEditMode}}</button>

