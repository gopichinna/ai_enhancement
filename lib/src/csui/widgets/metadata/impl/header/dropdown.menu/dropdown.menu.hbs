{{#if hasCommands}}
<div {{#unless isJATO}} class="binf-dropdown" {{/unless}}>
{{#if isJATO}}
<otc-button id="{{buttonID}}" class="cs-dropdown-button" type="subtle" showMoreText="{{showMoreTooltip}}" ariaLabel="{{showMoreAria}}" title="{{showMoreTooltip}}" size="small">
<otc-icon svg="{{iconSVG}}" type="subtle"></otc-icon>
</otc-button>
{{else}}
<button id="{{buttonID}}" type="button" class="cs-dropdown-button"
            aria-haspopup="true" aria-expanded="false"
            aria-label="{{showMoreAria}}" title="{{showMoreTooltip}}">
      <span class="csui-button-icon icon-expandArrowDown" title="{{showMoreTooltip}}"></span>
</button>
{{/if}}
<otc-menu buttonid="{{buttonID}}" ariarole="menu" role="none" scrollable></otc-menu>
</div>
{{else}}
  <div class="csui-loading-parent-wrapper binf-disabled binf-hidden">
  <span class="csui-loading-dots-wrapper">
    <span class="csui-loading-dot"></span>
    <span class="csui-loading-dot"></span>
    <span class="csui-loading-dot"></span>
  </span>
  </div>
{{/if}}


