<div class="cs-back-button-container">
  <otc-button class="cs-back-button"
    {{#if isJATO}} size="small" {{else}} icon="csui_action:action_back32" mirrorIconIfRtl {{/if}} arialabel="{{backTitle}}" title="{{backTitle}}">
    {{#if isJATO}}<otc-icon svg="{{backButtonIconSVG}}" type="subtle" mirrorifrtl></otc-icon>{{/if}}
  </otc-button>
</div>
<div class = "csui-filterToolbar"></div>
<div class="cs-title-container">
  <div class="cs-title-inner-container">
    {{#if widgetIconSvg}}      
      <otc-icon type="raw" size="24" svg="{{widgetIconSvg}}"></otc-icon>
    {{else}}
      <span class="title-icon {{icon}}"></span>
    {{/if}}
    <h2 class="title" title="{{title}}">{{title}}</h2>
  </div>
</div>
