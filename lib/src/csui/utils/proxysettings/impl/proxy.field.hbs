<div class="workflow-proxy-container">
    <div class="header-row">
        <div class="my-proxies" title="{{workflow}}">{{workflow}}</div>
        <span class="icon csui-icon-notification-information-white workflow-tooltip-btn" title="{{workflowInfo}}" tabindex="0"></span>
        <div class="binf-popover binf-fade binf-right binf-in binf-hidden" role="tooltip">
            <div class="binf-arrow"></div>
            <div class="binf-popover-content">
                {{workflowInfo}}
            </div>
        </div>
    </div>
    <div class="add-button-group">
        <a href="#" class="btn-add-workflow-proxy" role="button" aria-label="{{addWorkflowUserAria}}" tabindex="0">
            {{{icon-v2 iconName="csui_action_add32" size='small' states='true'}}}
            <span class="add-user-label">{{addUser}}</span>
        </a>
    </div>
    <div class="add-proxy-form-container binf-hidden">
        <div class="add-proxy-form">

        </div>
        <div class="footer">
            <div class="add-proxy-button-group">
                <otc-button type="secondary" title="{{save}}" arialabel="{{save}}" class="btn-save-proxy csui-default csui-acc-tab-region" size="small" role="none" >{{save}}</otc-button>
                <otc-button type="primary" title="{{cancel}}" arialabel="{{cancel}}" class="btn-cancel-proxy csui-default csui-acc-tab-region" size="small" role="none">{{cancel}}</otc-button>
            </div>
        </div>
    </div>
    <div class="binf-hidden empty-proxy" title="{{emptyDelegate}}">{{emptyDelegate}}</div>
</div>
<div class="workflow-proxy-list">

</div>
<br><br>
<div class="proxy-container">
    <div class="header-row">
        <div class="my-proxies" title="{{fullAccess}}">{{fullAccess}}</div>
        <span class="icon csui-icon-notification-information-white proxy-tooltip-btn" title="{{proxyInfo}}" tabindex="0"></span>
        <div class="binf-popover binf-fade binf-right binf-in binf-hidden" role="tooltip">
            <div class="binf-arrow"></div>
            <div class="binf-popover-content">
                {{proxyInfo}}
            </div>
        </div>
    </div>
    <div class="add-button-group">
        <a href="#" class="btn-add-proxy" role="button" aria-label="{{addFullAccessUserAria}}" tabindex="0">
            {{{icon-v2 iconName="csui_action_add32" size='small' states='true'}}}
            <span class="add-user-label">{{addUser}}</span>
        </a>
    </div>
    <div class="add-proxy-form-container binf-hidden">
        <div class="add-proxy-form">

        </div>
        <div class="footer">
            <div class="add-proxy-button-group">
                <otc-button type="secondary" title="{{save}}" arialabel="{{save}}" class="btn-save-proxy csui-default csui-acc-tab-region" size="small" role="none">{{save}}</otc-button>
                <otc-button type="primary" title="{{cancel}}" arialabel="{{cancel}}" class="btn-cancel-proxy csui-default csui-acc-tab-region" size="small" role="none">{{cancel}}</otc-button>
            </div>
        </div>
    </div>
    <div class="binf-hidden empty-proxy" title="{{emptyDelegate}}">{{emptyDelegate}}</div>
</div>
<div class="proxy-list">

</div>
