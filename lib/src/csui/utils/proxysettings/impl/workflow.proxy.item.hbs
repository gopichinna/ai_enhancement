<div class="proxy-user">
    <div class="user-form" tabindex="0">

    </div>
    <div class="csui-proxy-actions">
        <a href="#" class="btn-edit-proxy" role="button" aria-label="{{editProxyUserAria}}" tabindex="0" data-cstabindex="0">
            <span class="csui-icon-edit inline-edit-icon icon-edit icon-edit-proxy" title="{{edit}}"></span>
        </a>
        <a href="#" class="btn-remove-proxy" role="button" aria-label="{{removeProxyUserAria}}" tabindex="0" data-cstabindex="0">
            <span class="csui-button-icon circle_delete remove-icon icon-remove-proxy" title="{{remove}}"></span>
        </a>
    </div>
</div>
<div class="update-proxy-container binf-hidden">
    <div class="add-proxy-form-container">
        <div class="add-proxy-form">

        </div>
        <div class="footer">
            <div class="add-proxy-button-group">
                <otc-button type="primary" title="{{save}}" arialabel="{{save}}" class="btn-update-proxy csui-default csui-acc-tab-region" size="small" role="none" >{{save}}</otc-button>
                <otc-button type="secondary" title="{{cancel}}" arialabel="{{cancel}}" class="btn-cancel-update-proxy csui-default csui-acc-tab-region" size="small" role="none" >{{cancel}}</otc-button>
            </div>
        </div>
    </div>
</div>

