{{#if searchView}}
  <div class="csui-search-item-left-panel">
    <div class="csui-search-item-type">
      <span class="csui-type-label"> {{type}} </span>
    </div>
    <div class="csui-search-item">
      <div class="csui-search-item-name">
        {{name}}
      </div>
    </div>
  </div>
  <div class="csui-search-item-right-panel">
    <div class="csui-search-item-location">
      <div class="csui-search-toolbar-container">
        {{location}}
      </div>
    </div>
  </div>
{{else}}
  <div class="csui-targetbrowse-history">
      <span class="csui-targetbrowse-arrow-back">
      {{#if isJATO}}
      <otc-button class="cs-go-back"
        title="{{backButtonTooltip}}" arialabel="{{backButtonAria}}" data-cstabindex="-1" size="small">
        <otc-icon svg="{{jatoBackArrow}}" isPresentation mirrorIfRtl></otc-icon>
      </otc-button>
    {{else}}
      <otc-button icon="csui_action:action_back32" class="cs-go-back"
        title="{{backButtonTooltip}}" arialabel="{{backButtonAria}}" data-cstabindex="-1" mirrorIconIfRtl></otc-button>
    {{/if}}
  </div>
  <div class="csui-folder-name">
    <span class="folder-name" title="{{title}}">{{title}}</span>
    {{#if allMembers}}
      {{#if isJATO}}
      <otc-button class="csui-mp-search csui-acc-focusable"  tabindex="0" data-cstabindex="-1"
            role="button" aria-expanded="false" title="{{openSearchBar}}"
            aria-label="{{searchInButtonAria}}" size="small">
              <otc-icon svg="{{jatoSearchIcon}}" isPresentation></otc-icon>
            </otc-button>
       {{else}}
      <otc-button class="csui-mp-search csui-acc-focusable" icon="csui_action:action_search32" tabindex="0" data-cstabindex="-1"
            role="button" aria-expanded="false" title="{{openSearchBar}}"
            aria-label="{{searchInButtonAria}}"></otc-button>
            {{/if}}
    {{/if}}
  </div>

  <form class="cs-modal-filter">
    <div class="binf-form-group">
      <span class="icon-search-placeholder">{{{icon-v2 iconName='csui_action_search32'}}}</span>
      <input class="binf-form-control cs-filter-input" placeholder="{{search_placeholder}}" tabindex="0"
        data-cstabindex="-1" aria-label="{{search_aria}}">
      <span class="binf-form-control-feedback cs-icon icon-formfield-clear" role="button" title="{{clearSearchButtonAria}}"
        aria-label="{{clearSearchButtonAria}}" tabindex="0" data-cstabindex="-1"></span>
      {{#if isJATO}}
      <otc-button class="csui-form-control-search csui-mp-search-close" title="{{collapseSearch}}" aria-label="{{collapseSearch}}" size="small"
        aria-expanded="true" aria-haspopup="true" tabindex="0" data-cstabindex="-1">
        <otc-icon svg="{{jatoClose}}" size="16" isPresentation></otc-icon>
      </otc-button>
      {{else}}
      <button class="binf-btn csui-form-control-search" title="{{collapseSearch}}" aria-label="{{collapseSearch}}"
        aria-expanded="true" aria-haspopup="true" tabindex="0" data-cstabindex="-1">
        <span class="form-control-search cs-icon icon-sv-search-hide"></span>
      </button>
      {{/if}}
    </div>
  </form>
{{/if}}

