{{#if totalcount}}
{{else}}
  <span class="csui-item-standard csui-list-group-item" role="list">
    <div class="user-profile-row">
      <div class="user-profile-img  binf-pull-left">
        {{#if isJATO}}
          <otc-icon class="csui-icon csui-start-icon" svg="{{jatoCheckMarkSelect}}" ispresentation disableeffects></otc-icon>
        {{else}}
          <otc-icon class="csui-icon csui-start-icon" icon="csui_action:action_confirm32" ispresentation disableeffects></otc-icon>
        {{/if}}
        {{#if isGroup}}
          {{#if svgMimeGroup}}           
           <otc-icon type="raw" size="32" svg="{{svgMimeGroup}}" class="csui-user-default-picture-dlg csui-icon" isPresentation></otc-icon>
           <otc-icon class="csui-icon csui-end-icon binf-hidden" disableEffects="true" size="16px" svg="{{jatoRightCaretIcon}}" isPresentation></otc-icon>
          {{ else}}
            <otc-icon class="csui-user-default-picture-dlg csui-icon" icon="csui_action:mime_group32" isPresentation></otc-icon>
            <otc-icon class="csui-icon csui-end-icon binf-hidden" disableEffects="true" isPresentation icon="csui_action:action_caret_right32"></otc-icon>
          {{/if}}
        {{ else}}
          <otc-avatar class="csui-memberpicker-user-avator" image="" size="32" initials="{{initials}}">{{ initials }}</otc-avatar>
        {{/if}}
      </div>

      <div class="user-profile-info  binf-pull-left">
        <div class="{{#if isGroup}} user-group-name {{/if}}">
          <span title="{{name}}" class="binf-pull-left csui-list-item-title">{{name}}</span>
        </div>
        {{#unless isGroup}}
          <div>
            <span class="binf-pull-left csui-list-item-department" title="{{department}}">{{department}}</span>
          </div>
        {{/unless}}
      </div>

      <div class="csui-list-inlineactions-btn"></div>
    </div>
  </span>
{{/if}}

