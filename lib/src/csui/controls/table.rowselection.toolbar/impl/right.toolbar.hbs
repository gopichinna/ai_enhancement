{{#if showCondensedHeaderToggle}}
  <div class="csui-condensed-header-toggle-container">
    {{#if isJATO}}
    <otc-button title="{{toggleCondensedHeaderTooltip}}" type="subtle" class="csui-condensed-header-toggle" data-cstabindex="-1" arialabel="{{toggleCondensedHeaderAria}}" {{#if isJATO}} size="small" {{else}} icon="{{iconName}}" iconAppearance="{{iconAppearance}}"{{/if}}>
                {{#if isJATO}}<otc-icon class="icon icon-condensed-header-svg" size="18" svg="{{iconSVG}}"></otc-icon>{{/if}}
            </otc-button>
    {{else}}
    <button type="button" class="csui-condensed-header-toggle"
            title="{{toggleCondensedHeaderTooltip}}" aria-label="{{toggleCondensedHeaderAria}}">
      <span class="icon icon-condensed-header"></span>
    </button>
     {{/if}}       
  </div>
{{/if}}

