<otc-button
      class="csui-toolbar-table-settings csui-acc-focusable"
      title="{{toolbarButtonLabel}}"
      arialabel="{{toolbarButtonLabel}}"
      {{#if isJATO}} size="small" {{else}}
      iconOnly icon="{{iconName}}" iconAppearance="{{iconAppearance}}"
      {{/if}}
      id="{{toolbarButtonId}}">
            {{#if isJATO}}<otc-icon svg="{{iconSVG}}"></otc-icon>{{/if}}
</otc-button>
<otc-menu class="csui-table-settings-dropdown" buttonId="{{toolbarButtonId}}">
</otc-menu>

