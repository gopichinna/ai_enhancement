{{#if isJatoTheme}}
<otc-button type="subtle" size="small" class="csui-control csui-disclosure" ariaexpanded="{{ariaExpanded}}"
        arialabel="{{ariaLabel}}" {{disabled}} title="{{title}}">
  {{#if ariaExpanded}}
      <otc-icon svg='{{svgCaretUpIcon}}'></otc-icon>
  {{else}}
      <otc-icon svg='{{svgCaretDownIcon}}'></otc-icon>
  {{/if}}
</otc-button>
{{else}}
<button class="csui-control csui-disclosure" aria-expanded="{{ariaExpanded}}"
        aria-label="{{ariaLabel}}" {{disabled}} title="{{title}}">
  {{#if ariaExpanded}}
    {{{icon-v2 iconName='csui_caret_up' size='xsmall'}}}
  {{else}}
    {{{icon-v2 iconName='csui_caret_down' size='xsmall'}}}
  {{/if}}
</button>
{{/if}}
