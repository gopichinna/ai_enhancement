{{#if isJATO}}
<otc-button title="{{title}}" class="removebtn binf-hidden" type="subtle" size="small">
  <otc-icon svg="{{removeButtonSVG}}" type="subtle"></otc-icon>
</otc-button>
{{else}}
<button title="{{title}}" class="binf-btn binf-btn-default binf-btn-sm removebtn binf-hidden">
  <i class="csui-icon circle_delete"></i>
</button>
{{/if}}

