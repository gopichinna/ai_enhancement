<div class="control-area cs-field-write" id="cs-formfield-password">
  <div class="cs-field-write-inner">
    <input type="password" title="{{title}}" class="cs-formfield cs-passwordfield-input
    cs-passwordfield-write"
      {{#if options.placeholder}} placeholder="{{options.placeholder}}"{{/if}}
      {{#if name}}name="{{name}}"{{/if}} id="{{id}}"
      {{#if idBtnDescription}}aria-describedby="{{idBtnDescription}}" {{/if}}>
    </input>
    <div class="icon-container">
    {{#if isJATO}}
    <otc-button  class="inline-edit-icon csui-jato-edit-cancel" arialabel="{{cancel}}" type="subtle" size="small" tabindex="-1" data-cstabindex="-1" title="{{cancel}}">
      <otc-icon svg="{{editCancelIconSVG}}" type="subtle"></otc-icon>
    </otc-button>
    {{else}}
      <div class="csui-icon-edit inline-edit-icon edit-cancel" title="{{cancel}}"></div>
    {{/if}}
    </div>
  </div>
</div>

<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <input type="password" title="{{title}}" class="cs-formfield cs-passwordfield-input
    cs-passwordfield-read"
      {{#if options.placeholder}} placeholder="{{options.placeholder}}"{{/if}}
      {{#if name}}name="{{name}}"{{/if}} >
    </input>

    <div class="icon-container">
    {{#if isJATO}}
    <otc-button  class="csui-jato-icon-edit inline-edit-icon binf-hidden" arialabel="{{edit}}" type="subtle" size="small" tabindex="-1" data-cstabindex="-1" title="{{edit}}">
      <otc-icon svg="{{editIconSVG}}" type="subtle"></otc-icon>
    </otc-button>
    {{else}}
      <div title="{{edit}}" aria-label="{{edit}}" role="button"
           class="csui-icon-edit inline-edit-icon icon-edit"></div>
    {{/if}}
    </div>
  </div>
</div>
