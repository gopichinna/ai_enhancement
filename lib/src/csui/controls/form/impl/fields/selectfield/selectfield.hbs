<div class="cs-field-write">
  <div class="cs-field-write-inner cs-drop-down">
    <div id="{{idValueDiv}}"></div>
    <button id="{{idBtn}}" aria-label="{{writeModeAria}}" title="{{name}}" type="button"
            class="binf-btn binf-btn-default {{#unless this.disabled}} binf-dropdown-toggle"{{/unless}}
            data-binf-toggle="dropdown"
            aria-haspopup="menu" aria-expanded="false"
      {{#if idBtnDescription}}aria-describedby="{{idBtnDescription}}" {{/if}}>
      <span class="cs-label">{{name}}</span>
      {{#if isJATO}}
      <otc-icon size="16" class="csui-icon-expandArrowDown" {{#if this.disabled}} disabled="" {{/if}} svg="{{expandSVGContent}}"></otc-icon>
      {{else}}
      <span class="cs-icon icon-caret-down {{#if this.disabled}}cs-icon-disabled {{/if}}"></span>
      {{/if}}
    </button>
    <ul class="binf-dropdown-menu csui-normal-scrolling" role="menu" aria-labelledby="{{idBtn}}"></ul>
    {{#if this.isNotWriteOnly}}
    <div class="icon-container">
    {{#if isJATO}}
    <otc-button  class="inline-edit-icon csui-jato-edit-cancel" arialabel="{{cancel}}" type="subtle" size="small" tabindex="-1" data-cstabindex="-1" title="{{cancel}}">
      <otc-icon svg="{{editCancelIconSVG}}" type="subtle"></otc-icon>
    </otc-button>
    {{else}}
        <div class="csui-icon-edit inline-edit-icon edit-cancel" title="{{cancel}}"></div>
      {{/if}}
      </div>
    {{else}}
      {{#if this.applyFlag}}
        <div class="icon-container binf-hidden">
        {{#if isJATO}}
          <otc-button class="csui-icon apply-all block binf-hidden" title="{{titleApplyAll}}"
              arialabel="{{titleApplyAll}}" tabindex="0" size="small" type="subtle">
              <otc-icon svg="{{actionApplyToAll}}"></otc-icon>
          </otc-button>
        {{else}}
          <div class="csui-icon apply-all binf-hidden" title="{{titleApplyAll}}" tabindex="0"
               data-cstabindex="0"></div>
        {{/if}}
        </div>
      {{/if}}
    {{/if}}
  </div>
</div>

<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <div class="btn-container">
      <button aria-label="{{readModeAria}}"
          {{#if this.hasData}}
            title="{{name}}"
          {{else}}
            title="{{noValue}}"
          {{/if}}
          {{#if schema.readonly}} disabled {{else}}
            aria-haspopup="menu" aria-expanded="false"
          {{/if}}
        >
        {{#if this.hasData}}
          <span>{{name}}</span>
        {{else}}
          <span class="placeholder">{{emptyLabel}}</span>
        {{/if}}
      </button>
    </div>
    {{#if isNotReadOnly}}
    <div class="icon-container">
    {{#if isJATO}}
    <otc-button  class="csui-jato-icon-edit inline-edit-icon binf-hidden" arialabel="{{edit}}" type="subtle" size="small" tabindex="-1" data-cstabindex="-1" title="{{edit}}">
      <otc-icon svg="{{editIconSVG}}" type="subtle"></otc-icon>
    </otc-button>
    {{else}}
      <div class="csui-icon-edit inline-edit-icon icon-edit" title="{{edit}}"></div>
    {{/if}}
    </div>
    {{/if}}
  </div>
</div>

