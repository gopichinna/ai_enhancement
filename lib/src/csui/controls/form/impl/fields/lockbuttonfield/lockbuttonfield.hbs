{{#if locked}}
<div class="cs-field-read">
  <div class="cs-field-read-inner">
    <div class="btn-container">
      <span class="csui-btn-lock-status {{noActionCSS}}">
        <span title="{{tooltip}}" aria-label="{{pressToUnlock}}"
          class="csui-icon csui-icon-locked csui-btn-lock-status-action">
          {{{icon-v2 iconName="csui_mime_locked24" size='small' states='true'}}}
        </span>
        <span class="csui-lockby-status cs-formfield cs-userfield cs-formfield-readonly"></span>
        <input id="{{reserveid}}" class="binf-hidden" value="locked" type="button">
      </span>
    </div>
  </div>
</div>
{{/if}}
