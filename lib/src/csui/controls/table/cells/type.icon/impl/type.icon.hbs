{{#if defaultAction}}
  {{#if inactive}}
    <div class="csui-table-cell-no-default-action"></div>
  {{else}}
    <a class="csui-table-cell-default-action" href="{{defaultActionUrl}}"
       aria-label="{{nameAndTypeAria}}"></a>
  {{/if}}
{{else}}
  <div class="csui-table-cell-no-default-action"></div>
{{/if}}

