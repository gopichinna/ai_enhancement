{{#if value}}
  <div class="csui-permission-level-container {{#if isCFTheme}} csui-fadeout {{/if}}">
    {{#if isCFTheme}}
    <span class="csui-permission-level {{# if noEditPermissions }}csui-simple-permissions{{/if}}" aria-label="{{permissionLevelAria}}">{{value}}</span>
    {{else}}
    <otc-button type="subtle"  class="csui-permission-level {{# if noEditPermissions }}csui-simple-permissions{{/if}}" size="small"
                  arialabel="{{permissionLevelAria}}" title="{{value}}">
                    {{value}}
            </otc-button>
    {{/if}}
    <div class="csui-tree"></div>
  </div>
{{/if}}
