{{#if isTypeAhead}}
  <div class="search-box csui-table-searchbox cs-item-picker{{#unless show_input}} binf-hidden{{/unless}}"
        aria-label="{{search_input_tooltip}}" role="combobox" aria-expanded="false" aria-haspopup="listbox">
    <input type="text" class="csui-table-search-input typeahead"
        placeholder="{{search_placeholder}}" title="{{search_input_tooltip}}" aria-autocomplete="list">
    {{#if svgSearchIcon}}
      <otc-icon size="16" class="icon-search-placeholder" title="{{search_input_tooltip}}" svg='{{svgSearchIcon}}'></otc-icon>
    {{else}}
    <span class="icon-search-placeholder" title="{{search_input_tooltip}}">{{{icon-v2
            iconName='csui_action_search32' size='contain' theme=iconTheme}}}</span>
    {{/if}}
    {{#if svgCloseIcon}}
      <otc-icon size="16" class="typeahead sbclearer binf-hidden" role="button" ariaexpanded="false"
        title="{{search_clear_icon_tooltip}}"  arialabel="{{search_clear_icon_tooltip}}"
        tabindex="0" svg='{{svgCloseIcon}}'></otc-icon>
    {{else}}
    <span class="typeahead sbclearer binf-hidden formfield_clear" role="button" aria-expanded="false"
        title="{{search_clear_icon_tooltip}}" aria-label="{{search_clear_icon_tooltip}}"
        tabindex="0"></span>
     {{/if}}
  </div>
{{else}}
  <div class="search-box csui-table-searchbox{{#unless show_input}} binf-hidden{{/unless}}">
    {{#if svgSearchIcon}}
      <otc-icon size="16" class="icon-search-placeholder" title="{{search_input_tooltip}}" svg='{{svgSearchIcon}}'></otc-icon>
    {{else}}
    <span class="icon-search-placeholder" title="{{search_input_tooltip}}">{{{icon-v2
          iconName='csui_action_search32' size='contain' theme=iconTheme}}}</span>
    {{/if}}
    <input type="search" class="csui-table-search-input"
       placeholder="{{search_placeholder}}" title="{{search_input_tooltip}}" value="{{search_value}}">
    <span class="fadeout csui-icon" title="{{search_input_tooltip}}"></span>
    {{#if svgCloseIcon}}
      <otc-icon size="16" class="sbclearer binf-hidden" role="button"
        title="{{search_clear_icon_tooltip}}"  arialabel="{{search_clear_icon_tooltip}}"
        tabindex="0" svg='{{svgCloseIcon}}'></otc-icon>
    {{else}}
    <span class="sbclearer binf-hidden formfield_clear" role="button"
          title="{{search_clear_icon_tooltip}}" aria-label="{{search_clear_icon_tooltip}}"
          tabindex="0"></span>
    {{/if}}
  </div>
{{/if}}
{{#if svgSearchIcon}}
  <otc-button type="subtle" size="small" class="csui-table-search-icon" ariaexpanded="false"
     arialabel="{{search_icon_tooltip}}" title="{{search_icon_tooltip}}" tabindex="0">
     <otc-icon svg='{{svgSearchIcon}}'></otc-icon>
  </otc-button>
{{else}}
<div class="csui-table-search-icon" role="button" aria-expanded="false"
     aria-label="{{search_icon_tooltip}}" title="{{search_icon_tooltip}}" tabindex="0">
</div>
{{/if}}
