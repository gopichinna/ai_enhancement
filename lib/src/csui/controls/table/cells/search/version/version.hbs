{{#if has_version}}
  <div class="csui-search-results-version csui-search-item-version-{{cid}}">
    <a href="javascript:void(0);" class="csui-search-version-label" aria-label="{{versionAria}}" tabindex="0">{{versionText}}
    </a>
  </div>
{{else}}
  {{#if visibleNoVersionText}}
      <span class="csui-search-results-version-none">{{noVersionsText}}</span>
  {{/if}}
{{/if}}
