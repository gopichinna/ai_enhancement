<div class="csui-user-container">
{{#if isPublicPermission}}
  <div class="csui-profileimg binf-pull-left">
  {{#if jatoIcon}}
    <otc-icon svg="{{jatoIcon}}" size="24" type="raw" class="csui-table-control-user-cell-img" title="{{publicAccessLabel}}" arialabel="{{publicAccessLabel}}"></otc-icon>
  {{else}}
    <span class="csui-icon-paceholder csui-icon icon_permmision_public"
          title="{{publicAccessLabel}}" aria-label="{{publicAccessLabel}}"></span>
  {{/if}}
  </div>
  <div class="member-info{{#if disabled}} binf-disabled{{/if}}">
    <div class="">
      <span class="csui-user-display-name csui-public">{{publicAccessLabel}}</span>
    </div>
  </div>
{{else}}
  {{#if showProfileImg}}
    <div class="csui-profileimg{{#if disabled}} binf-disabled{{/if}} binf-pull-left">
    {{#if jatoIcon}}
      <otc-icon svg="{{jatoIcon}}" size="24" type="raw" class="csui-table-control-user-cell-img" title="{{title}}"></otc-icon>
    {{else}}
      <span class="csui-icon {{#if isOwner}} icon_permmision_owner {{else}}
          {{#if isOwnerGroup}} icon_permmision_owner_group {{else}} csui-icon-paceholder
          {{#if isGroup}} image_group_placeholder_permission
          {{else}} image_user_placeholder_permission{{/if}}{{/if}}{{/if}}" title="{{title}}">
            {{#if isUser}}
              {{#if isJATO}}
                <otc-button type="subtle" class="csui-user-icon" size="small" arialabel="{{userTypeAria}}">
                  <otc-avatar class="csui-profile-img" image="" size="24" initials="{{initials}}"></otc-avatar>
                </otc-button>
              {{else}}
                <otc-avatar class="csui-profile-img cf-csui-profile-img" image="" initials="{{initials}}" arialabel="{{userTypeAria}}" interactive></otc-avatar>
              {{/if}}
            {{/if}}
      </span>
    {{/if}}
    </div>
  {{/if}}
  <div class="member-info">
    {{#if addOwnerOrGroup}}
      <div class="csui-add-owner-or-group">
        <span class="csui-user-display-name binf-disabled">{{name}}</span>
        <span class="csui-icon"></span>
      </div>
    {{else}}
      <div class="">
        <span class="csui-user-display-name{{#if disabled}} binf-disabled{{/if}}"
              aria-label="{{userTypeAria}}">{{name}}</span>
      </div>
    {{/if}}
  </div>
{{/if}}
{{#if includeInlineToolBarPlaceholder}}
  {{#if isOwnerOrOwnerGroup}}
    <div class="csui-inline-owner-change"></div>
  {{/if}}
  {{#unless addOwnerOrGroup}}
    <div class="{{inlineToolBarPlaceholderClass}} binf-hidden"></div>
  {{/unless}}
{{/if}}
</div>
{{#if selectedUsername}}
  <div class="csui-selected-user-ingroup">
    <span class="icon icon-toolbar-more"></span>
    <span class="csui-selected-username">{{selectedUsername}}</span>
  </div>
{{/if}}
