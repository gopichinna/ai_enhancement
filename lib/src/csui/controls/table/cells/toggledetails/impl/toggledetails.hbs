{{#if hasMetadataRow}}
{{#if isJatoTheme}}
  <otc-button type="subtle" size="small" class="expand-details-row-toggle" title="{{expandToggleTooltip}}"
     arialabel="{{expandToggleAria}}"
     data-binf-toggle="collapse" ariaexpanded="{{ariaExpanded}}"
     ariacontrols="csui-details-row-{{id}}">
    {{#if ariaExpanded}}
        <otc-icon size="16" svg='{{svgCaretUpIcon}}'></otc-icon>
    {{else}}
        <otc-icon size="16" svg='{{svgCaretDownIcon}}'></otc-icon>
    {{/if}}
  </otc-button>
{{else}}
  <a class="expand-details-row-toggle" title="{{expandToggleTooltip}}"
     aria-label="{{expandToggleAria}}"
     href="#csui-details-row-{{id}}" data-binf-toggle="collapse" aria-expanded="{{ariaExpanded}}"
     aria-controls="csui-details-row-{{id}}">
    {{#if ariaExpanded}}
      {{{icon-v2 iconName='csui_caret_up' size='xsmall' }}}
    {{else}}
      {{{icon-v2 iconName='csui_caret_down' size='xsmall' }}}
    {{/if}}
  </a>
{{/if}}
{{/if}}

