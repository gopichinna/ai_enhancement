<input type="text" class="binf-form-control cs-inline-nodepicker csui-inlineform-type-{{prefix}} {{#if
           haveErrorMessage}}csui-inlineform-error{{/if}} {{#if isRequired}}csui-nodepicker-required {{/if}}"
      value="{{anchorTitleShort}}" placeholder="{{namePlaceholder}}"
      aria-label="{{#if anchorTitleShort}}{{anchorTitleShort}}{{else}}{{namePlaceholder}}{{/if}}"
      title="{{#if anchorTitleShort}}{{anchorTitleShort}}{{else}}{{namePlaceholder}}{{/if}}" {{#if
      haveErrorMessage}} aria-errormessage="{{errorMsgId}}" aria-invalid="true" {{/if}} readonly disabled />
<span class="csui-inlineform-nodepicker-icon-container">
      <button type="button" class="csui-inlineform-nodepicker-icon csui-icon formfield_clear" aria-label="{{clearIconAriaLabelTooltip}}" ></button>
      <button type="button" class="csui-inlineform-nodepicker-icon csui-icon icon-cs-browse" {{#if isRequired}} aria-required="{{isRequired}}"  {{/if}} aria-label="{{browseIconAriaLabelTooltip}}"></button>
</span>
