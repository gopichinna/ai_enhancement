<otc-input value="{{name}}" placeholder="{{namePlaceholder}}"
           ariaLabel="{{#if name}}{{name}}{{else}}{{namePlaceholder}}{{/if}}"
           actionicon="{{actionIcon}}"
  {{#if haveErrorMessage}} aria-invalid="true" {{/if}}>
</otc-input>
<span class="csui-multilingual-icon-label">
  {{#if isJATO}}
    <otc-button  class="csui-multilingual-icon" type="subtle" size="small">
      <otc-icon svg="{{globeIconSVG}}"></otc-icon>
    </otc-button>
  {{else}}
    <otc-button class="csui-multilingual-icon" type="inline" icon="action:action_localize32"></otc-button>
  {{/if}}
</span>

