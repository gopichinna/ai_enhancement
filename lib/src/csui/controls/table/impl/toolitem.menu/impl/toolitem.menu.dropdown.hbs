{{#each items}}
  {{#if this.isGroupStart}}
    <otc-menugroup>
  {{/if}}
  {{#if this.isGroupEnd}}
    </otc-menugroup>
  {{/if}}
  {{#if this.isDivider}}
    <otc-menudivider></otc-menudivider>
  {{/if}}
  {{#if this.isCheckable}}
    <otc-menuradio data-csui-command="{{this.signature}}" {{#if this.isChecked}}checked{{/if}}>{{this.name}}</otc-menuradio>
  {{/if}}
  {{#if this.isItem}}
    <otc-menuitem data-csui-command="{{this.signature}}">{{this.name}}</otc-menuitem>
  {{/if}}
{{/each}}

