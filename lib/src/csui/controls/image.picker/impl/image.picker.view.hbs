<div class="csui-brand-image-logo">
   <div class="csui-default-image-logo"></div>
   <span class="csui-logo-image"></span>
   <span class="csui-newLogo-image" height="auto" width="256px"></span>
</div>
<span class="csui-help-text" title="{{helpText}}"> {{helpText}}</span>
<div class="csui-logo-btns" tabindex="0" role="button">
   <label for="{{logoImageId}}" aria-label="{{uploadAria}}" class="csui-logo-upload-label">
      <span class="csui-logo-upload-icon" aria-hidden="true"></span> {{uploadLabel}}
   </label>
   <input id="{{logoImageId}}" class="csui-logo-upload-input" type="file" tabindex="-1"/>
</div>
