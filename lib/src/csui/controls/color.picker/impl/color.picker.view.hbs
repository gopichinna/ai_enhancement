<div class="csui-color-picker-wrapper{{#if noDefaultColor}} no-color-overlay{{/if}}"{{#if defaultColor}} style="background:{{defaultColor}}"{{/if}}>
    <input class="csui-color-picker" aria-hidden="true" type="color"{{#if defaultColor}} 
                    title="{{defaultColor}}" value="{{defaultColor}}"{{/if}} tabindex="-1"/>
</div>
<label class="csui-color-label" aria-label="{{selectColorAria}}" title="{{defaultColorLabel}}">{{defaultColorLabel}}</label>
