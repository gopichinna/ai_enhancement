{{#if isNodesExists }}
  <div class="csui-tree-child {{#if nodeSplit}} {{splitClass}}{{/if}} {{#if
  nodeClass}} nodeClass{{/if}}">
  <otc-checkbox
  id="node_{{nodeId}}"
  name="{{nodeId}}"
  arialabel="{{nodeName}}"
  tabindex="-1"
  class="csui-tree-checkbox {{#if nodeClass}} nodeClass {{/if}}"
  {{#if checked}} checked {{/if}}
  {{#if readonly}} disabled {{/if}}
  interactiveonly="">
  </otc-checkbox>
  <span class="csui-node-name">{{nodeName}}</span>
  {{#if nodeSplit}}
      <div class="csui-tree-split {{splitClass}}">
        <div class="csui-splitcontrol-label">
          <span title="{{splitName}}">{{splitName}}</span>
        </div>
      </div>
      <div class="csui-separator"></div>
  {{/if}}
  </div>
  <ul></ul>
  {{else}}
    <div class="csui-tree-child {{#if nodeSplit}} {{splitClass}}{{/if}}">
     <otc-checkbox
      id="node_{{nodeId}}"
      name="{{nodeId}}"
      arialabel="{{nodeName}}"
      tabindex="-1"
      class="csui-tree-checkbox {{#if nodeClass}} nodeClass {{/if}}"
      {{#if checked}} checked {{/if}}
      {{#if readonly}} disabled {{/if}}
      interactiveonly="">
      </otc-checkbox>
     <span class="csui-node-name">{{nodeName}}</span>
      {{#if nodeSplit}}
        <div class="csui-tree-split {{splitClass}}">
          <div class="csui-splitcontrol-label">
            <span title="{{splitName}}">{{splitName}}</span>
          </div>
        </div>
        <div class="csui-separator"></div>
      {{/if}}
    </div>
  {{/if}}
