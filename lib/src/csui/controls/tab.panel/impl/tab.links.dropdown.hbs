<div class="csui-meta-data">
{{#if single_item}}
{{#if isJatoTheme}}
    <otc-button
      id="{{btnId}}"
      class="cs-metadata-dropdown-jato"
      disabled>
      {{selectedTitle}}
    </otc-button>
{{else}}
  <button id="{{btnId}}" type="button" class="cs-metadata-dropdown" disabled>
    <span class="cs-label">{{selectedTitle}}</span>
  </button>
{{/if}} 
{{else}}
  {{#if isJatoTheme}}
    <otc-button
      id="{{btnId}}"
      class="cs-metadata-dropdown-jato"
      type="subtleDropdown"
      title="{{dropdownButtonTitle}}"
      arialabel="{{dropdownButtonAria}}"
      tabindex="0"
    >
      {{selectedTitle}}
    </otc-button>
    {{else}}
    <button id="{{btnId}}"
          type="button"
          class="cs-metadata-dropdown"
          tabindex="0" aria-haspopup="true" aria-expanded="false"
          aria-label="{{dropdownButtonAria}}" 
          title="{{dropdownButtonTitle}}">
      <span class="cs-label">{{selectedTitle}}</span>
      <span class="cs-icon icon-caret-down"></span>
    </button>
    {{/if}}
    <otc-menu 
      class="csui-metadata-dropdown" 
      buttonId="{{btnId}}" 
      ariarole="menu"
      scrollable="">
    </otc-menu>
  {{/if}}
</div>

