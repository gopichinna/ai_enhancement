{{#if locked}}
  {{#if isJATO}}
  <otc-button type="status" title="{{lockedTooltip}}" ariaLabel="{{lockedAria}}" class="csui-unlock-cellview" {{#unless canUnlock}}disabled{{/unless}}>
    <otc-icon svg="{{iconSVG}}"></otc-icon>
  </otc-button>
  {{else}}
    {{#if canUnlock}}
    <button type="button" title="{{lockedTooltip}}" aria-label="{{lockedAria}}" class="csui-unlock-cellview">
    {{/if}}
      <span title="{{lockedTooltip}}" class="{{noActionCSS}} csui-icon-locked"> {{{icon-v2 iconName="csui_mime_locked24" size='small' states='true'}}} </span>
    {{#if canUnlock}}
    </button>
    {{/if}}
  {{/if}}
{{/if}}
