{{#if isReserved}}
  {{#if canUnreserve}}
    <button title="{{reservedTooltip}}" type="button" tabindex="-1" aria-label="{{canUnreserveAria}}">
  {{/if}}
      <span title="{{reservedTooltip}}"{{#unless canUnreserve}} aria-label="{{reservedAria}}"{{/unless}} class="icon {{iconPrefix}}_{{#if isReservedByOther}}other{{else}}self{{/if}}"></span>
  {{#if canUnreserve}}
    </button>
  {{/if}}
{{/if}}

