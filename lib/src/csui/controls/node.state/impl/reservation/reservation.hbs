{{#if isReserved}}
{{#if isJATO}}
<otc-button type="status" class="csui-jato-reserve-state" tabindex="{{tabIndex}}"  title="{{reservedTooltip}}" ariaLabel="{{ariaLabel}}">
  <otc-icon svg="{{iconSVG}}"></otc-icon>
</otc-button>
{{else}}
<button title="{{reservedTooltip}}" type="button" tabindex="{{tabIndex}}" aria-label="{{ariaLabel}}">
  <span title="{{reservedTooltip}}"{{#unless canUnreserve}} aria-label="{{reservedAria}}"{{/unless}} class="icon {{iconPrefix}}_{{#if isReservedByOther}}other{{else}}self{{/if}}"></span>
</button>
{{/if}}
{{/if}}

