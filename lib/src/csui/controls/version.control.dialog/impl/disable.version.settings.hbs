<div class="binf-row">
  <div class="binf-col-sm-12 binf-control-label">
    {{disableVersioningTitle}}
  </div>
  <div class="binf-col-sm-12">
    <label class="cs-radio-inline">
      <input type="radio" name="versioncontrol" value='{{currentFolder}}' tabindex='0' checked>
      <span class="cs-radio-container"><span class="outer"><span class="inner"></span></span></span>
      {{currentFolder}}
    </label>
  </div>
  <div class="binf-col-sm-12">
    <label class="cs-radio-inline">
      <input type="radio" name="versioncontrol" value='{{currentAndSubfolder}}' tabindex='0'>
      <span class="cs-radio-container"><span class="outer"><span class="inner"></span></span></span>
      {{currentAndSubfolder}}
    </label>
  </div>
</div>

