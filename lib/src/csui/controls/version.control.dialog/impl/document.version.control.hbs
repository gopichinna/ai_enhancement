<div class="binf-row">
  <div class="binf-col-sm-12 binf-control-label">
    {{uploadDocument}}
  </div>
  <div class="binf-col-sm-12">
    <label class="cs-radio-inline">
      <input type="radio" name="versioncontrol" value="{{majorMinorVersion}}" tabindex='0'checked>
      <span class="cs-radio-container"><span class="outer"><span class="inner"></span></span></span>
      {{majorMinorVersion}}
    </label>
  </div>
  <div class="binf-col-sm-12 csui-minor-example">{{majorMinorExample}}</div>
  <div class="binf-col-sm-12">
    <label class="cs-radio-inline">
      <input type="radio" name="versioncontrol" value="{{majorVersion}}" tabindex='0'>
      <span class="cs-radio-container"><span class="outer"><span class="inner"></span></span></span>
      {{majorVersion}}
    </label>
  </div>
  <div class="binf-col-sm-12 csui-minor-example">{{majorVersionExample}}</div>
</div>
