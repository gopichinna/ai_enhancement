<div class='binf-row'>
  
<div class="binf-col-sm-12 csui-version-warning {{#if hideWarningMessage }} binf-hidden {{/if}}" id = "{{warningMessageId}}">
    {{warningMessage}}
  </div>
  <div class="binf-col-sm-12 csui-version-update {{#if hideSelectVersion }} binf-hidden {{/if}}">
  <div class="binf-control-label">
  {{selectVersionlabel}}
  </div>
    <label class="cs-radio-inline">
      <input type="radio" name="version" value="true" checked aria-label="{{minorVersionlabel}}">
      <span class="cs-radio-container"><span class="outer"><span class="inner"></span></span></span>
      {{minorVersion}}
    </label>
    <label class="cs-radio-inline">
      <input type="radio" name="version" value="false" aria-label="{{majorVersionlabel}}">
      <span class="cs-radio-container"><span class="outer"><span class="inner"></span></span></span>
      {{majorVersion}}
    </label>
  </div>
  <div class="binf-col-sm-12 csui-version-reserve {{#if isNotReserved }} binf-hidden {{/if}}">
    <otc-checkbox name="reserve" arialabel="{{unreserve}}" tabindex="-1" interactiveonly=""></otc-checkbox>
    <label class="binf-checkbox-inline"> {{keepDocumentReserved}} </label>
  </div>
  <div class="binf-col-sm-12 csui-version-description" >
    <label class=" binf-control-label" for="{{descriptionFieldId}}" id = "{{descriptionLabelId}}">{{description}}</label>
    <div class="version-description"></div>
  <div/>
</div>


