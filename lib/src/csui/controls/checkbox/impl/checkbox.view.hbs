<otc-checkbox class="csui-control csui-checkbox"
  {{#if disabled}} disabled="" {{/if}}
  {{#if checked}} checked="" {{/if}}
  {{#if indeterminate}} indeterminate="" {{/if}}
  {{#if interactiveOnly}} interactiveOnly="" {{/if}}
  {{#if ariaLabel}}ariaLabel="{{ariaLabel}}"{{/if}}
  {{#if infoMessage}}infoMessage="{{infoMessage}}"{{/if}}
  {{#if title}}title="{{title}}"{{/if}} >
    {{#if label}}{{label}}{{/if}}
</otc-checkbox>
