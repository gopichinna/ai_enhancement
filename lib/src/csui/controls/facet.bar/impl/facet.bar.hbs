<div class="csui-facet-bar-container {{#if showSaveFilter}}with-saveas-btn{{/if}}"></div>
{{#if showSaveFilter}}
  {{#if isJATO}}
    <otc-button class=" csui-filter-save binf-hidden" type="primary" size="small"
    ariaLabel="{{saveAsAria}}" >{{saveas}}</otc-button>
  {{else}}
    <button class="binf-btn binf-btn-primary csui-filter-save binf-hidden"
    aria-label="{{saveAsAria}}">{{saveas}}</button>
  {{/if}}
{{/if}}

