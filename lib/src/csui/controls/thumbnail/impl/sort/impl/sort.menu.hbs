<div class="csui-thumbnail-sort-options">
  <otc-button
    id="{{id}}"
    class="cs-dropdown-button open-sort-menu"
      type="inline"
    title="{{sortByTooltip}}"
  >
    <span class="cs-label">{{selectedValue}}</span>
    {{#if isJatoTheme}}
      <otc-icon svg="{{jatoChevronSmallDown}}" size="24" type="subtle"></otc-icon>
    {{else}}
      <otc-icon icon="smart_action:action_caret_down32"></otc-icon>
    {{/if}}
  </otc-button>
  {{#if isJatoTheme}}
    <otc-button class="csui-sort-arrow" title="{{selectedArrowTooltip}}"
      arialabel="{{selectedArrowAria}}" type="inline" size="small" tabindex="0">
      <otc-icon svg="{{jatoOrderIcon}}" size="18" type="subtle"></otc-icon>
    </otc-button>
  {{else}}
    <a href="#"
      class="csui-sort-arrow {{selectedArrowClass}}"
      title="{{selectedArrowTooltip}}"
      aria-label="{{selectedArrowAria}}"
      role="button"
      tabindex="0"
    ></a>
  {{/if}}
  <otc-menu
    class="csui-table-settings-dropdown"
    buttonId="{{id}}"
    ariarole="menu"
    maxitems="0"
    scrollable=""
  >
  </otc-menu>
</div>
