    <otc-icon svg='{{svgPropertiesIcon}}'></otc-icon>
  </otc-button>
  {{else}}
    <button type="button" class="csui-btn-metadata binf-btn" title="{{propertiesTitle}}">
    {{{icon-v2 iconName='csui_action_properties32' states='true' }}}
  </button>
  {{/if}}
</div>


