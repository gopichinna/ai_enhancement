{{#if showNextCard}}
  <a class="csui-settings-option {{classname}}" id="{{id}}" href="javascript:void(0);" tabindex="-1" title="{{label}}" aria-haspopup="menu" role="menuitem">
  <span class="csui-settings-option-title">{{label}}</span>
  <span class="icon icon-next-card"></span>
  </a>
{{else}}
  <a class="csui-settings-option {{classname}}" id="{{id}}" href="javascript:void(0);" tabindex="-1" title="{{label}}" role="radio" aria-checked = "{{selected}}">
    <span class="icon icon-listview-checkmark"></span>
    <span class="csui-settings-option-title">{{label}}</span>
  </a>
{{/if}}
