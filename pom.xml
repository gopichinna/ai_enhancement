        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.8.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>2.22.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.0.2</version>
          <configuration>
            <archive>
              <manifestEntries>
                <D2-Version>${d2.version}</D2-Version>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>1.8</version>
          <executions>
            <execution>
              <id>init-npm</id>
              <phase>initialize</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <echo message="" />
                  <echo message="Setting-up npm project ${project.name}" />
                  <exec osfamily="windows" dir="${basedir}/src/main/smartview" executable="cmd" failonerror="true">
                    <arg value="/c" />
                    <arg value="npm" />
                    <arg value="run" />
                    <arg value="setup" />
                  </exec>
                  <exec osfamily="unix" dir="${basedir}/src/main/smartview" executable="sh" failonerror="true">
                    <arg value="-c" />
                    <arg value="npm run setup" />
                  </exec>
                  <echo message="" />
                </target>
              </configuration>
            </execution>
            <execution>
              <id>npm-run-build</id>
              <phase>generate-resources</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <echo message="" />
                  <echo message="Building SmartView code for ${project.name}" />
                  <exec osfamily="windows" dir="${basedir}/src/main/smartview" executable="cmd" failonerror="true">
                    <arg value="/c" />
                    <arg value="npm" />
                    <arg value="run" />
                    <arg value="compile" />
                  </exec>
                  <exec osfamily="unix" dir="${basedir}/src/main/smartview" executable="sh" failonerror="true">
                    <arg value="-c" />
                    <arg value="npm run compile" />
                  </exec>
                  <echo message="" />
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
