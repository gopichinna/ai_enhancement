<div class="ai-summary-modal-container" style="padding: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  
  <div style="background-color: #f0f7fb; border-left: 4px solid #0072aa; padding: 10px 14px; margin-bottom: 14px; border-radius: 4px;">
    <strong>Document:</strong> <span style="color: #0072aa; font-weight: 600;">{{objectName}}</span>
  </div>

  <div style="font-weight: 600; margin-bottom: 6px; color: #333;">AI Executive Summary:</div>

  <div class="summary-text-area" 
       style="max-height: 380px; overflow-y: auto; background-color: #fff; border: 1px solid #ccd1d5; border-radius: 4px; padding: 14px; font-size: 14px; line-height: 1.6; color: #222; white-space: pre-wrap;">{{summaryText}}</div>

</div>
